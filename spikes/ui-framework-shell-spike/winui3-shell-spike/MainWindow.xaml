<Window
    x:Class="WinUi3ShellSpike.MainWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#FFF4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top shell bar -->
        <Border Grid.Row="0" Background="#FF0F172A" Padding="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="☰"
                        Width="36"
                        Height="32"
                        Command="{Binding ToggleScopeCommand}"/>
                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           Text="LabAssistant Shell Spike - WinUI 3"
                           Foreground="White"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Margin="10,0,0,0"
                           Text="{Binding ActiveCapabilityLabel}"
                           Foreground="#FFD1D5DB"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="{Binding DenseModeLabel}"
                        Command="{Binding ToggleDenseModeCommand}"
                        MinWidth="130"/>
                <Button Grid.Column="4"
                        Content="Add Shell Issue"
                        Command="{Binding AddIssueCommand}"
                        Margin="8,0,0,0"/>
                <Border Grid.Column="5"
                        Background="#FF7F1D1D"
                        CornerRadius="12"
                        Padding="10,4"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Foreground="White" Text="{Binding ActiveIssuesLabel}"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding LeftPaneTitle}" FontSize="16" FontWeight="SemiBold" Margin="12,12,12,0"/>
                    <TextBlock Grid.Row="1" Text="{Binding LeftPaneDescription}" Margin="12,0,12,0" TextWrapping="Wrap" Foreground="#FF4B5563"/>

                    <Grid Grid.Row="2" Margin="12,0,12,12">
                        <ListView x:Name="CapabilityListView"
                                  ItemsSource="{Binding Capabilities}"
                                  Visibility="{Binding CapabilityPaneVisibility}"
                                  SelectionMode="Single"
                                  SelectionChanged="CapabilityListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4" Background="#FFF9FAFB">
                                        <TextBlock Text="{Binding}" Foreground="#FF111827"/>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView ItemsSource="{Binding ContextItems}" Visibility="{Binding ContextPaneVisibility}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4" Background="#FFF9FAFB">
                                        <TextBlock Text="{Binding}" Foreground="#FF111827"/>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main dense content fixture -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ContentHeader}" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Mode: Quick"/>
                            <TextBlock Text="Pass: 8"/>
                            <TextBlock Text="Warn: 5" Foreground="#FF92400E"/>
                            <TextBlock Text="Fail: 3" Foreground="#FFB91C1C"/>
                            <TextBlock Text="Blocked: True" Foreground="#FFB91C1C"/>
                        </StackPanel>
                        <TextBlock Text="Dense content fixture only (readiness summary + cards + logs placeholders) to evaluate shell layout ergonomics."
                                   TextWrapping="Wrap"
                                   Foreground="#FF4B5563"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="8">
                    <StackPanel Spacing="8">
                        <Button Content="{Binding ReadinessDetailsButtonLabel}" Command="{Binding ToggleReadinessDetailsCommand}" HorizontalAlignment="Left"/>
                        <ScrollViewer MaxHeight="180" Visibility="{Binding ReadinessDetailsVisibility}">
                            <ItemsControl ItemsSource="{Binding ReadinessDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="8">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding VmCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                                <TextBlock Text="| Guest-step outcomes / controls placeholder" Foreground="#FF6B7280"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Shell Error Feed Placement Concept" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding ActiveIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFFCA5A5" Background="#FFFEF2F2" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Source}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FF7F1D1D"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Dismiss"
                                                        Tag="{Binding}"
                                                        Click="DismissIssue_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Right rail is used here only to assess shell-level placement and interaction tradeoffs."
                                       TextWrapping="Wrap"
                                       Foreground="#FF6B7280"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right rail -->
            <Border Grid.Column="2" Background="#FFF8FAFC" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Context / Diagnostics Rail" FontWeight="SemiBold"/>
                    <TextBlock Text="This column intentionally competes with dense content to evaluate shell composition tradeoffs."
                               TextWrapping="Wrap"
                               Foreground="#FF4B5563"/>
                    <ItemsControl ItemsSource="{Binding LogGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6"
                                        Background="White">
                                    <TextBlock Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
