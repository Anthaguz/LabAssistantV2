<Window
    x:Class="WinUi3ShellSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#FF111827" Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰" Width="36" Height="32" Command="{Binding ToggleScopeCommand}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="LabAssistant Shell Spike - WinUI 3" Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveCapability, StringFormat=| Active: {0}}" Foreground="#FFD1D5DB"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding DenseModeLabel}" Command="{Binding ToggleDenseModeCommand}"/>
                <Button Grid.Column="3" Content="Add Shell Issue" Command="{Binding AddIssueCommand}"/>
                <InfoBadge Grid.Column="4" Value="{Binding ActiveIssueCount}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane -->
            <Border Grid.Column="0" CornerRadius="8" BorderBrush="#22000000" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding LeftPaneTitle}" FontSize="16" FontWeight="SemiBold" Margin="12,12,12,0"/>
                    <TextBlock Grid.Row="1" Text="{Binding LeftPaneDescription}" Margin="12,0,12,0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Grid Grid.Row="2" Margin="12,0,12,12">
                        <ListView ItemsSource="{Binding Capabilities}" Visibility="{Binding CapabilityPaneVisibility}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Margin="0,2,0,2"
                                            Command="{Binding DataContext.SelectCapabilityCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView ItemsSource="{Binding ContextItems}" Visibility="{Binding ContextPaneVisibility}" SelectionMode="None"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main dense content fixture -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="8" BorderBrush="#22000000" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ContentHeader}" FontSize="18" FontWeight="SemiBold"/>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Mode: Quick" Margin="0,0,12,0"/>
                            <TextBlock Text="Pass: 8" Margin="0,0,12,0"/>
                            <TextBlock Text="Warn: 5" Margin="0,0,12,0" Foreground="#FF92400E"/>
                            <TextBlock Text="Fail: 3" Margin="0,0,12,0" Foreground="#FFB91C1C"/>
                            <TextBlock Text="Blocked: True" Foreground="#FFB91C1C"/>
                        </WrapPanel>
                        <TextBlock Text="Dense content fixture only (readiness summary + list + cards + logs placeholders)." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" CornerRadius="8" BorderBrush="#22000000" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
                    <StackPanel Spacing="8">
                        <Button Content="{Binding ReadinessDetailsButtonLabel}" Command="{Binding ToggleReadinessDetailsCommand}" HorizontalAlignment="Left"/>
                        <ScrollViewer MaxHeight="180" Visibility="{Binding ReadinessDetailsVisibility}">
                            <ItemsControl ItemsSource="{Binding ReadinessDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" BorderBrush="#22000000" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="8">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding VmCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                                <TextBlock Text="| Guest-step outcomes / controls placeholder" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="8" BorderBrush="#22000000" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Shell Error Feed Placement Concept" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding ActiveIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#33B91C1C" Background="#FFFEE2E2" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Source}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FF7F1D1D"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Dismiss"
                                                        Command="{Binding DataContext.DismissIssueCommand, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Right-side shell placement concept only; used for comparison of shell composition ergonomics."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right rail -->
            <Border Grid.Column="2" CornerRadius="8" BorderBrush="#22000000" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Context / Diagnostics Rail" FontWeight="SemiBold"/>
                    <TextBlock Text="Used to evaluate shell composition tradeoffs with dense content and shell-level issue surfacing."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding LogGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#22000000" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <TextBlock Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
