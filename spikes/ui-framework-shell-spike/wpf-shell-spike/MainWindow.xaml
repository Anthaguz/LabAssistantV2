<Window x:Class="WpfShellSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfShellSpike.ViewModels"
        Title="WPF Shell Spike"
        Width="1320"
        Height="840"
        MinWidth="980"
        MinHeight="640">
    <Window.DataContext>
        <vm:ShellSpikeViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#FFF4F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top shell bar -->
        <Border Grid.Row="0" Background="#FF0F172A" Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="☰"
                            Width="36"
                            Height="32"
                            Margin="0,0,10,0"
                            Command="{Binding ToggleScopeCommand}"/>
                    <TextBlock Text="LabAssistant Shell Spike - WPF"
                               Foreground="White"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveCapability, StringFormat= | Active: {0}}"
                               Margin="10,0,0,0"
                               Foreground="#FFD1D5DB"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding DenseModeLabel}"
                            Command="{Binding ToggleDenseModeCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Add Shell Issue"
                            Command="{Binding AddIssueCommand}"
                            Margin="0,0,8,0"/>
                    <Border Background="#FF7F1D1D" CornerRadius="12" Padding="10,4">
                        <TextBlock Foreground="White"
                                   Text="{Binding ActiveIssueCount, StringFormat=Issues: {0}}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane -->
            <Border Grid.Column="0" Margin="12,12,8,12" Background="White" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding LeftPaneTitle}" FontWeight="SemiBold" FontSize="16" Margin="12,12,12,4"/>
                    <TextBlock Grid.Row="1" Text="{Binding LeftPaneDescription}" Margin="12,0,12,8" Foreground="#FF4B5563" TextWrapping="Wrap"/>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding Capabilities}"
                                 Visibility="{Binding IsCapabilityScope, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="12,0,12,12"
                                 SelectedItem="{Binding ActiveCapability, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Command="{Binding DataContext.SelectCapabilityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,2,0,2"
                                            HorizontalContentAlignment="Left"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox ItemsSource="{Binding ContextItems}" Margin="12,0,12,12">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapabilityScope}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main content density fixture -->
            <Grid Grid.Column="1" Margin="4,12,4,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding ContentHeader}" FontSize="18" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Mode: Quick" Margin="0,0,12,0"/>
                            <TextBlock Text="Pass: 8" Margin="0,0,12,0"/>
                            <TextBlock Text="Warn: 5" Margin="0,0,12,0" Foreground="#FF92400E"/>
                            <TextBlock Text="Fail: 3" Margin="0,0,12,0" Foreground="#FFB91C1C"/>
                            <TextBlock Text="Blocked: True" Foreground="#FFB91C1C"/>
                        </WrapPanel>
                        <TextBlock Text="Dense content fixture only (readiness summary + cards + logs placeholders) to evaluate shell layout ergonomics."
                                   Margin="0,6,0,0"
                                   Foreground="#FF4B5563"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Expander Grid.Row="1" Header="{Binding ReadinessDetails.Count, StringFormat=Readiness Details ({0})}" IsExpanded="False" Margin="0,0,0,8">
                    <Border Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="8">
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReadinessDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,6,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VmCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                                <TextBlock Text="  |  Guest-step outcomes / controls placeholder" Foreground="#FF6B7280"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="8" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Shell Error Feed Placement Concept" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ActiveIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFFCA5A5" Background="#FFFEF2F2" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Dismiss"
                                                        Command="{Binding DataContext.DismissIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="8,0,0,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Source}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FF7F1D1D"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Right rail is used here only to assess shell-level placement and interaction tradeoffs."
                                       Foreground="#FF6B7280"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right shell rail concept -->
            <Border Grid.Column="2" Margin="8,12,12,12" Background="#FFF8FAFC" CornerRadius="8" BorderBrush="#FFE5E7EB" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="Context / Diagnostics Rail" FontWeight="SemiBold"/>
                    <TextBlock Text="This column intentionally competes with dense content to evaluate shell composition tradeoffs."
                               Margin="0,6,0,8" TextWrapping="Wrap" Foreground="#FF4B5563"/>
                    <ItemsControl ItemsSource="{Binding LogGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6" Background="White">
                                    <TextBlock Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
