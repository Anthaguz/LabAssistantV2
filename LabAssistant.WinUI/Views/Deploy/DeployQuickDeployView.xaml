<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployQuickDeployView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LabAssistant.WinUI.Converters"
    xmlns:deployModels="using:LabAssistant.WinUI.Models.Deploy"
    x:Name="Root"
    x:DefaultBindMode="OneWay">
    <UserControl.Resources>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Warning badge uses a light amber fill with dark text so it reads as clearly yellow
             and stays distinct from the red critical badge. Based on the caution style so the
             value-text layout is preserved while Background/Foreground override the dark orange fill. -->
        <Style
            x:Key="WarningValueInfoBadgeStyle"
            BasedOn="{StaticResource CautionValueInfoBadgeStyle}"
            TargetType="InfoBadge">
            <Setter Property="Background" Value="{ThemeResource ShellWarnBadgeBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource ShellWarnBadgeForegroundBrush}" />
        </Style>
    </UserControl.Resources>
    <Border
        Padding="{StaticResource CardPadding}"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardCornerRadius}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="DeployQuickDeployReadinessSummaryPanel"
                Grid.Row="0"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <Grid ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.LifecycleState}" />
                    <ProgressBar
                        Grid.Column="1"
                        Height="12"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.ProgressPercent}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasActiveProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ProgressSummary}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasActiveProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <InfoBadge
                            Style="{StaticResource CriticalValueInfoBadgeStyle}"
                            VerticalAlignment="Center"
                            Value="{x:Bind ViewModel.BlockingIssueCount, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.BlockingBadgeTooltip, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.BlockingBadgeTooltip, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasBlockingIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <InfoBadge
                            Style="{StaticResource WarningValueInfoBadgeStyle}"
                            VerticalAlignment="Center"
                            Value="{x:Bind ViewModel.WarningIssueCount, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.WarningBadgeTooltip, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.WarningBadgeTooltip, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasWarningIssues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{x:Bind ViewModel.ToggleResultsPanelCommand}"
                            Content="{x:Bind ViewModel.ResultsPanelButtonText}"
                            IsEnabled="{x:Bind ViewModel.CanToggleResultsPanel}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Foreground="{StaticResource ShellWarnBrush}"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.GlobalIssuesBadgeText}"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ReadinessDisplayText}"
                        Visibility="{x:Bind ViewModel.ShowReadinessSummaryLine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Grid
                x:Name="DeployQuickDeployWorkspaceGrid"
                Grid.Row="1"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DeployQuickDeployListColumnDefinition" Width="1.05*" />
                    <ColumnDefinition x:Name="DeployQuickDeployEditorColumnDefinition" Width="1.25*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DeployQuickDeployPrimaryRowDefinition" Height="*" />
                    <RowDefinition x:Name="DeployQuickDeployEditorRowDefinition" Height="0" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DeployQuickDeployVmEntriesPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid RowSpacing="{StaticResource SpacingS}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Virtual Machines" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.VmEntryRows}"
                            SelectedItem="{x:Bind ViewModel.SelectedVmEntryRow, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="deployModels:DeployQuickDeployVmEntryRow">
                                    <Grid ToolTipService.ToolTip="{x:Bind IssueTooltip, Mode=OneWay}">
                                        <!-- Severity outline + leading accent bar, shown only when the entry
                                             has a blocking/warning issue. Overlaid on the content so toggling
                                             visibility never shifts the row layout. -->
                                        <Border
                                            BorderBrush="{x:Bind IssueSeverity, Mode=OneWay, Converter={StaticResource SeverityToBrush}}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}"
                                            Visibility="{x:Bind HasIssueBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Border
                                            Width="4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Stretch"
                                            Background="{x:Bind IssueSeverity, Mode=OneWay, Converter={StaticResource SeverityToBrush}}"
                                            CornerRadius="2,0,0,2"
                                            Visibility="{x:Bind HasIssueBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                        <Grid Padding="12,4,6,4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock
                                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind DisplayName, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                    FontSize="12"
                                                    Text="{x:Bind SecondaryText, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                Click="OnRemoveVmRowClick"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                ToolTipService.ToolTip="Remove VM"
                                                VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                            <Button
                                Command="{x:Bind ViewModel.AddVmCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                ToolTipService.ToolTip="Add VM"
                                Content="Add VM" />
                            <Button
                                Command="{x:Bind ViewModel.RemoveVmCommand}"
                                Content="Remove VM"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="DeployQuickDeployVmEditorPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid RowSpacing="{StaticResource SpacingS}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="VM Properties" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid RowSpacing="{StaticResource SpacingS}" ColumnSpacing="{StaticResource SpacingS}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Name" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <TextBox
                                        Text="{x:Bind ViewModel.EditorVmNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind ViewModel.HasEditorNameError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource ShellCriticalBrush}"
                                            Glyph="&#xEA39;" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellCriticalBrush}"
                                            FontSize="12"
                                            Text="{x:Bind ViewModel.EditorNameValidationText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Memory (MB)" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.EditorVmMemoryDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="CPU" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.EditorVmCpuDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Base disk" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Base disk"
                                        ItemsSource="{x:Bind ViewModel.VhdxCatalogItems}"
                                        SelectedItem="{x:Bind ViewModel.SelectedVhdxCatalogItem, Mode=TwoWay}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind ViewModel.ShowBaseDiskHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource ShellAccentBrush}"
                                            Glyph="&#xE946;" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellAccentBrush}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.BaseDiskHintText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Switches" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SwitchRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployQuickDeploySwitchRowItem">
                                                <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        Grid.Column="0"
                                                        MinWidth="220"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.Name="Host switch"
                                                        ItemsSource="{x:Bind Options}"
                                                        SelectedItem="{x:Bind SelectedSwitch, Mode=TwoWay}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Content="-"
                                                        AutomationProperties.Name="Remove switch"
                                                        Click="OnRemoveSwitchRowClick"
                                                        ToolTipService.ToolTip="Remove switch" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        Command="{x:Bind ViewModel.AddSwitchRowCommand}"
                                        HorizontalAlignment="Left"
                                        Content="+ Add Switch" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        FontSize="12"
                                        Text="{x:Bind ViewModel.SwitchGuidanceText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Button
                            Grid.Row="2"
                            Command="{x:Bind ViewModel.ApplyVmChangesCommand}"
                            Content="Apply VM Changes"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

            </Grid>

            <Border
                Grid.Row="2"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel Spacing="{StaticResource SpacingS}">
                    <Grid ColumnSpacing="{StaticResource SpacingS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource SpacingS}">
                            <Button
                                Command="{x:Bind ViewModel.EvaluateCommand}"
                                Content="Evaluate"
                                Visibility="Collapsed" />
                            <HyperlinkButton
                                Command="{x:Bind ViewModel.OpenTemplateEditorCommand}"
                                Content="Save as template..."
                                ToolTipService.ToolTip="Saves the current VM entries as a reusable template in the Templates editor." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.StartDeployCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Start Deploy" />
                    </Grid>
                    <TextBlock
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.StatusText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
