<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployQuickDeployView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LabAssistant.WinUI.Converters"
    xmlns:deployModels="using:LabAssistant.WinUI.Models.Deploy"
    x:Name="Root"
    x:DefaultBindMode="OneWay">
    <UserControl.Resources>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Border
        Padding="{StaticResource CardPadding}"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardCornerRadius}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="DeployQuickDeployReadinessSummaryPanel"
                Grid.Row="0"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <Grid ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.LifecycleState}" />
                    <ProgressBar
                        Grid.Column="1"
                        Height="12"
                        Minimum="0"
                        Maximum="100"
                        Value="{x:Bind ViewModel.ProgressPercent}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ProgressSummary}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        Spacing="{StaticResource SpacingXS}">
                        <Button
                            Command="{x:Bind ViewModel.ToggleResultsPanelCommand}"
                            Content="{x:Bind ViewModel.ResultsPanelButtonText}"
                            IsEnabled="{x:Bind ViewModel.CanToggleResultsPanel}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            FontSize="12"
                            Text="{x:Bind ViewModel.ResultsPanelSummaryText}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Foreground="{StaticResource ShellWarnBrush}"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.GlobalIssuesBadgeText}"
                        Visibility="Collapsed" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ReadinessDisplayText}" />
                </Grid>
            </Border>

            <Grid
                x:Name="DeployQuickDeployWorkspaceGrid"
                Grid.Row="1"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DeployQuickDeployListColumnDefinition" Width="1.05*" />
                    <ColumnDefinition x:Name="DeployQuickDeployEditorColumnDefinition" Width="1.25*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DeployQuickDeployPrimaryRowDefinition" Height="*" />
                    <RowDefinition x:Name="DeployQuickDeployEditorRowDefinition" Height="0" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DeployQuickDeployVmEntriesPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid RowSpacing="{StaticResource SpacingS}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="VM Entries" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.VmEntryRows}"
                            SelectedItem="{x:Bind ViewModel.SelectedVmEntryRow, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="deployModels:DeployQuickDeployVmEntryRow">
                                    <Grid Padding="6,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind DisplayName, Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                FontSize="12"
                                                Text="{x:Bind SecondaryText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{x:Bind IssueSeverity, Mode=OneWay, Converter={StaticResource SeverityToBrush}}"
                                                FontSize="12"
                                                Text="{x:Bind IssueSummary, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind HasIssueSummary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            Padding="8,3"
                                            Background="{StaticResource ShellContentBackgroundBrush}"
                                            BorderBrush="{StaticResource ShellBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource PillCornerRadius}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind HasIssueBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock
                                                Foreground="{x:Bind IssueSeverity, Mode=OneWay, Converter={StaticResource SeverityToBrush}}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind IssueBadgeText, Mode=OneWay}" />
                                        </Border>

                                        <Button
                                            Grid.Column="2"
                                            Click="OnRemoveVmRowClick"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            ToolTipService.ToolTip="Remove VM"
                                            VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                            <Button
                                Command="{x:Bind ViewModel.AddVmCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                ToolTipService.ToolTip="Add VM"
                                Content="Add VM" />
                            <Button
                                Command="{x:Bind ViewModel.RemoveVmCommand}"
                                Content="Remove VM"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="DeployQuickDeployVmEditorPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid RowSpacing="{StaticResource SpacingS}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="VM Properties" />

                        <TextBlock
                            Grid.Row="1"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.EditorIssueSummaryText}"
                            TextWrapping="Wrap" />

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid RowSpacing="{StaticResource SpacingS}" ColumnSpacing="{StaticResource SpacingS}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Name" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.EditorVmNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Memory (MB)" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.EditorVmMemoryDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="CPU" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.EditorVmCpuDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Base disk" />
                                <ComboBox
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Base disk"
                                    ItemsSource="{x:Bind ViewModel.VhdxCatalogItems}"
                                    SelectedItem="{x:Bind ViewModel.SelectedVhdxCatalogItem, Mode=TwoWay}" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Switches" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SwitchRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployQuickDeploySwitchRowItem">
                                                <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        Grid.Column="0"
                                                        MinWidth="220"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.Name="Host switch"
                                                        ItemsSource="{x:Bind Options}"
                                                        SelectedItem="{x:Bind SelectedSwitch, Mode=TwoWay}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Content="-"
                                                        AutomationProperties.Name="Remove switch"
                                                        Click="OnRemoveSwitchRowClick"
                                                        ToolTipService.ToolTip="Remove switch" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        Command="{x:Bind ViewModel.AddSwitchRowCommand}"
                                        HorizontalAlignment="Left"
                                        Content="+ Add Switch" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        FontSize="12"
                                        Text="{x:Bind ViewModel.SwitchGuidanceText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    FontSize="12"
                                    Text="{x:Bind ViewModel.VhdxGuidanceText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </ScrollViewer>

                        <Button
                            Grid.Row="3"
                            Command="{x:Bind ViewModel.ApplyVmChangesCommand}"
                            Content="Apply VM Changes"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

            </Grid>

            <Border
                Grid.Row="2"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <StackPanel Spacing="{StaticResource SpacingS}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                        <Button
                            Command="{x:Bind ViewModel.EvaluateCommand}"
                            Content="Evaluate"
                            Visibility="Collapsed" />
                        <Button
                            Command="{x:Bind ViewModel.ResolveSuggestionsCommand}"
                            Content="Resolve Suggestions" />
                        <Button
                            Command="{x:Bind ViewModel.OpenTemplateEditorCommand}"
                            Content="Open in Templates Editor" />
                        <Button
                            Command="{x:Bind ViewModel.StartDeployCommand}"
                            Content="Start Deploy" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.StatusText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
