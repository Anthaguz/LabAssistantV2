<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployOnTheFlyRightPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LabAssistant.WinUI.ViewModels.Deploy"
    x:Name="Root"
    x:DefaultBindMode="OneWay">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="8"
            Background="{StaticResource ShellContentBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Spacing="8">
                <TextBlock
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="Quick Deploy progress and VM step details."
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.OverallStatusText}" />
                <ProgressBar
                    Height="8"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind ViewModel.ProgressPercentValue}" />
                <TextBlock
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="{x:Bind ViewModel.ProgressSummaryText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="10"
                Background="{StaticResource ShellBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{x:Bind ViewModel.LoadingVisibility}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="16" Height="16" IsActive="True" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ProgressSummaryText}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Border
                    Padding="10"
                    Background="{StaticResource ShellBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{x:Bind ViewModel.EmptyStateVisibility}">
                    <TextBlock
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.EmptyStateMessage}"
                        TextWrapping="Wrap" />
                </Border>

                <ListView ItemsSource="{x:Bind ViewModel.VmProgressItems}" SelectionMode="None" Visibility="{x:Bind ViewModel.VmProgressVisibility}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DeployVmProgressItem">
                            <Border
                                Margin="0,0,0,8"
                                Padding="10,8"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind VmName}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{x:Bind Status}" />
                                    </Grid>
                                    <ProgressBar
                                        Grid.Row="1"
                                        Height="6"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{x:Bind ProgressPercent}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind DisplaySummary}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind SummaryVisibility}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
