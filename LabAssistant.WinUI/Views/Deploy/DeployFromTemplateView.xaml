<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployFromTemplateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LabAssistant.WinUI.Converters"
    xmlns:deployModels="using:LabAssistant.WinUI.Models.Deploy"
    x:Name="Root"
    x:DefaultBindMode="OneWay">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Border
        Padding="{StaticResource CardPadding}"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardCornerRadius}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpacingS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="DeployTemplateSelectorComboBox"
                    Grid.Column="0"
                    DisplayMemberPath="Name"
                    IsEnabled="{x:Bind ViewModel.IsTemplateSelectorEnabled, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.TemplateItems}"
                    PlaceholderText="Select a template"
                    SelectedItem="{x:Bind ViewModel.SelectedTemplateLibraryItem, Mode=TwoWay}" />
                <Button
                    Grid.Column="1"
                    MinWidth="86"
                    Command="{x:Bind ViewModel.ReloadTemplatesCommand}"
                    Content="Reload"
                    ToolTipService.ToolTip="Reload templates" />
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.EvaluateReadinessCommand}"
                    Content="{x:Bind ViewModel.EvaluateButtonText, Mode=OneWay}" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                        <Grid ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.LifecycleState, Mode=OneWay}" />
                            <ProgressBar
                                Grid.Column="1"
                                Height="12"
                                Minimum="0"
                                Maximum="100"
                                Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Spacing="{StaticResource SpacingXS}">
                                <Button
                                    Command="{x:Bind ViewModel.ToggleResultsPanelCommand}"
                                    Content="{x:Bind ViewModel.ResultsPanelButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanToggleResultsPanel, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    FontSize="12"
                                    Text="{x:Bind ViewModel.ResultsPanelSummaryText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ReadinessSummaryText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Foreground="{StaticResource ShellWarnBrush}"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.GlobalIssuesBadgeText, Mode=OneWay}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Visibility="{x:Bind ViewModel.V2Review.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="V2 Review and Resolve" />
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.V2Review.StatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Plan Summary" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.V2Review.PlanSummaryText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="{StaticResource SpacingS}">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Base Remote Access" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="Legacy script defaults are enabled for this V2 deploy unless you change them here."
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        Content="Enable Remote Desktop"
                                        IsChecked="True"
                                        IsEnabled="False" />
                                    <CheckBox
                                        Content="Set network profile to Private"
                                        IsChecked="True"
                                        IsEnabled="False" />
                                    <CheckBox
                                        Content="Disable Windows Firewall"
                                        IsChecked="{x:Bind ViewModel.V2DisableFirewall, Mode=TwoWay}" />
                                    <CheckBox
                                        Content="Disable RDP NLA"
                                        IsChecked="{x:Bind ViewModel.V2DisableRdpNla, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Blocking Items" />
                                    <ListView
                                        MaxHeight="180"
                                        ItemsSource="{x:Bind ViewModel.V2Review.BlockerRows, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployV2BlockerRow">
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Message}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                        FontSize="12"
                                                        Text="{x:Bind Severity}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                        FontSize="12"
                                                        Text="{x:Bind Scope}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="{StaticResource SpacingS}">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Resolve Credential Slots" />
                                    <ListView
                                        x:Name="DeployV2CredentialSlotsListView"
                                        MaxHeight="180"
                                        ItemsSource="{x:Bind ViewModel.V2Review.CredentialSlotRows, Mode=OneWay}"
                                        SelectionChanged="OnDeployV2CredentialSlotSelectionChanged"
                                        SelectionMode="Single">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployV2CredentialSlotRow">
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind SlotKey}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind PurposeSummary}" TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind AffectedVmSummary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind ViewModel.V2CredentialSlotEditorText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="{StaticResource SpacingS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            Header="Username"
                                            PlaceholderText="User name"
                                            Text="{x:Bind ViewModel.V2CredentialSlotUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <PasswordBox
                                            x:Name="DeployV2CredentialSlotPasswordBox"
                                            Grid.Column="1"
                                            Header="Password" />
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Bottom"
                                            Click="OnDeployV2SaveCredentialSlotRequested"
                                            Content="Save Slot" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Execution Waves" />
                                    <ListView
                                        MaxHeight="180"
                                        ItemsSource="{x:Bind ViewModel.V2Review.WaveRows, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployV2WaveRow">
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Expander Header="Diagnostics Detail">
                                <Border
                                    Margin="0,8,0,0"
                                    Padding="8"
                                    Background="{StaticResource ShellBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}">
                                    <ListView
                                        MaxHeight="180"
                                        ItemsSource="{x:Bind ViewModel.V2Review.DiagnosticRows, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployV2DiagnosticRow">
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                        <Grid RowSpacing="{StaticResource SpacingS}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Template Review" />
                            <TextBlock
                                Grid.Row="1"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.TemplateSummaryText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="2"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.TemplateRemediationText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                        <StackPanel Spacing="{StaticResource SpacingS}">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Remediation and Deploy" />
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.SharedIssuesSummaryText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ListView
                                MaxHeight="160"
                                ItemsSource="{x:Bind ViewModel.SharedIssueSummaries, Mode=OneWay}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                                <Button
                                    Command="{x:Bind ViewModel.ResolveSuggestionsCommand}"
                                    Content="Resolve Suggestions" />
                                <Button
                                    Command="{x:Bind ViewModel.OpenTemplateEditorCommand}"
                                    Content="Fix in Templates Editor" />
                                <Button
                                    Command="{x:Bind ViewModel.StartDeployCommand}"
                                    Content="Start Deploy" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ActionStatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
