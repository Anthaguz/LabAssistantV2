<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployFromTemplateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LabAssistant.WinUI.Converters"
    xmlns:deployModels="using:LabAssistant.WinUI.Models.Deploy"
    x:Name="Root"
    x:DefaultBindMode="OneWay">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Stretches per-VM rows to the full list width and removes default item padding. -->
        <Style x:Key="StretchListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Per-VM live row shared by the PROGRESS and RESULTS surfaces, modeled on the Quick Deploy right panel. -->
        <DataTemplate x:Key="DeployVmProgressRowTemplate" x:DataType="deployModels:DeployVmResultRow">
            <Border
                Margin="0,0,0,8"
                Padding="10,8"
                Background="{StaticResource ShellBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="{x:Bind VmName}" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="{x:Bind Status}" />
                    </Grid>
                    <ProgressBar
                        Grid.Row="1"
                        Height="6"
                        Minimum="0"
                        Maximum="100"
                        AutomationProperties.Name="Virtual machine progress"
                        AutomationProperties.HelpText="Shows the completion percentage for the current virtual machine."
                        Value="{x:Bind ProgressPercent}" />
                    <TextBlock
                        Grid.Row="2"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind DisplaySummary}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Border
        Padding="{StaticResource CardPadding}"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardCornerRadius}">
        <Grid>

            <!--
                Main content is one of three mutually exclusive surfaces routed by the lane's lifecycle
                state: CONFIG (template selection and review), PROGRESS (live per-VM deploy feedback),
                and RESULTS (terminal per-VM outcome). Exactly one is visible at a time.
            -->

            <!-- CONFIG surface. -->
            <Grid
                RowSpacing="10"
                Visibility="{x:Bind ViewModel.ShouldShowConfigView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpacingS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="DeployTemplateSelectorComboBox"
                    Grid.Column="0"
                    DisplayMemberPath="Name"
                    IsEnabled="{x:Bind ViewModel.IsTemplateSelectorEnabled, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.TemplateItems}"
                    PlaceholderText="Select a template"
                    SelectedItem="{x:Bind ViewModel.SelectedTemplateLibraryItem, Mode=TwoWay}" />
                <Button
                    x:Name="DeployTemplateReloadButton"
                    Grid.Column="1"
                    MinWidth="86"
                    Command="{x:Bind ViewModel.ReloadTemplatesCommand}"
                    Content="Reload"
                    ToolTipService.ToolTip="Reload templates" />
                <Button
                    x:Name="DeployTemplateEvaluateButton"
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.EvaluateReadinessCommand}"
                    Content="{x:Bind ViewModel.EvaluateButtonText, Mode=OneWay}" />
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Visibility="{x:Bind ViewModel.V2Review.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="V2 Review and Resolve" />
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.V2Review.StatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Plan Summary" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.V2Review.PlanSummaryText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="{StaticResource SpacingS}">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Base Remote Access" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="Legacy script defaults are enabled for this V2 deploy unless you change them here."
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        Content="Enable Remote Desktop"
                                        IsChecked="True"
                                        IsEnabled="False" />
                                    <CheckBox
                                        Content="Set network profile to Private"
                                        IsChecked="True"
                                        IsEnabled="False" />
                                    <CheckBox
                                        Content="Disable Windows Firewall"
                                        IsChecked="{x:Bind ViewModel.V2DisableFirewall, Mode=TwoWay}" />
                                    <CheckBox
                                        Content="Disable RDP NLA"
                                        IsChecked="{x:Bind ViewModel.V2DisableRdpNla, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Blocking Items" />
                                    <ListView
                                        MaxHeight="180"
                                        ItemsSource="{x:Bind ViewModel.V2Review.BlockerRows, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployV2BlockerRow">
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Message}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                        FontSize="12"
                                                        Text="{x:Bind Severity}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                        FontSize="12"
                                                        Text="{x:Bind Scope}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="{StaticResource SpacingS}">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Resolve Credential Slots" />
                                    <ListView
                                        x:Name="DeployV2CredentialSlotsListView"
                                        MaxHeight="180"
                                        ItemsSource="{x:Bind ViewModel.V2Review.CredentialSlotRows, Mode=OneWay}"
                                        SelectionChanged="OnDeployV2CredentialSlotSelectionChanged"
                                        SelectionMode="Single">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployV2CredentialSlotRow">
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind SlotKey}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind PurposeSummary}" TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind AffectedVmSummary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind ViewModel.V2CredentialSlotEditorText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="{StaticResource SpacingS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="DeployV2CredentialSlotUsernameTextBox"
                                            Grid.Column="0"
                                            Header="Username"
                                            PlaceholderText="User name"
                                            Text="{x:Bind ViewModel.V2CredentialSlotUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <PasswordBox
                                            x:Name="DeployV2CredentialSlotPasswordBox"
                                            Grid.Column="1"
                                            Header="Password" />
                                        <Button
                                            x:Name="DeployV2CredentialSlotSaveButton"
                                            Grid.Column="2"
                                            VerticalAlignment="Bottom"
                                            Click="OnDeployV2SaveCredentialSlotRequested"
                                            Content="Save Slot" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Execution Waves" />
                                    <ListView
                                        MaxHeight="180"
                                        ItemsSource="{x:Bind ViewModel.V2Review.WaveRows, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployV2WaveRow">
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Expander Header="Diagnostics Detail">
                                <Border
                                    Margin="0,8,0,0"
                                    Padding="8"
                                    Background="{StaticResource ShellBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}">
                                    <ListView
                                        MaxHeight="180"
                                        ItemsSource="{x:Bind ViewModel.V2Review.DiagnosticRows, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="deployModels:DeployV2DiagnosticRow">
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                        <Grid RowSpacing="{StaticResource SpacingS}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Template Review" />
                            <TextBlock
                                Grid.Row="1"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.TemplateSummaryText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Row="2"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.TemplateRemediationText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                        <StackPanel Spacing="{StaticResource SpacingS}">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Remediation and Deploy" />
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.SharedIssuesSummaryText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ListView
                                MaxHeight="160"
                                ItemsSource="{x:Bind ViewModel.SharedIssueSummaries, Mode=OneWay}">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                                <Button
                                    Command="{x:Bind ViewModel.ResolveSuggestionsCommand}"
                                    Content="Resolve Suggestions" />
                                <Button
                                    Command="{x:Bind ViewModel.OpenTemplateEditorCommand}"
                                    Content="Fix in Templates Editor" />
                                <Button
                                    x:Name="DeployTemplateStartButton"
                                    Command="{x:Bind ViewModel.StartDeployCommand}"
                                    Content="Start Deploy" />
                            </StackPanel>
                            <TextBlock
                                x:Name="DeployTemplateActionStatusText"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ActionStatusText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <!-- PROGRESS surface: live per-VM deployment feedback while a run is in flight. -->
            <Grid
                RowSpacing="10"
                Visibility="{x:Bind ViewModel.ShouldShowProgressView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    AutomationProperties.LandmarkType="Custom"
                    AutomationProperties.LocalizedLandmarkType="Deployment status summary">
                    <StackPanel Spacing="{StaticResource SpacingS}">
                        <TextBlock
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="Deploying from template. Live per-VM progress and step details."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DeployTemplateProgressLifecycleText"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.LifecycleState, Mode=OneWay}" />
                        <ProgressBar
                            Height="8"
                            Minimum="0"
                            Maximum="100"
                            AutomationProperties.Name="Overall deployment progress"
                            AutomationProperties.HelpText="Shows total deployment completion percentage."
                            Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                    ItemTemplate="{StaticResource DeployVmProgressRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.ResultRows, Mode=OneWay}"
                    SelectionMode="None"
                    AutomationProperties.Name="Virtual machine deployment progress list"
                    AutomationProperties.HelpText="Shows the current deploy progress for each virtual machine." />
            </Grid>

            <!-- RESULTS surface: terminal per-VM outcome with return actions. -->
            <Grid
                RowSpacing="10"
                Visibility="{x:Bind ViewModel.ShouldShowResultsView, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    AutomationProperties.LandmarkType="Custom"
                    AutomationProperties.LocalizedLandmarkType="Deployment results summary">
                    <StackPanel Spacing="{StaticResource SpacingS}">
                        <TextBlock
                            x:Name="DeployTemplateResultLifecycleText"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.LifecycleState, Mode=OneWay}" />
                        <TextBlock
                            x:Name="DeployTemplateResultSummaryText"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                    ItemTemplate="{StaticResource DeployVmProgressRowTemplate}"
                    ItemsSource="{x:Bind ViewModel.ResultRows, Mode=OneWay}"
                    SelectionMode="None"
                    AutomationProperties.Name="Virtual machine deployment results list"
                    AutomationProperties.HelpText="Shows the terminal deploy outcome for each virtual machine." />

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingS}">
                    <Button
                        Command="{x:Bind ViewModel.BackToConfigurationCommand}"
                        Content="Back to configuration" />
                    <Button
                        Command="{x:Bind ViewModel.DeployAgainCommand}"
                        Content="Deploy again"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
