<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployFromTemplateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Foreground="{StaticResource ShellTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Deploy From Template" />

            <TextBlock
                Grid.Row="1"
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="Deploy from-template with compact status, expandable per-VM details, and collapsed global issue drawer."
                TextWrapping="Wrap" />

            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="DeployTemplateSelectorComboBox"
                    Grid.Column="0"
                    PlaceholderText="Select a template (AF3 wiring pending)" />
                <Button
                    x:Name="DeployReloadTemplatesButton"
                    Grid.Column="1"
                    Content="Reload" />
                <Button
                    x:Name="DeployEvaluateReadinessButton"
                    Grid.Column="2"
                    Content="Evaluate" />
            </Grid>

            <Border
                x:Name="DeployReadinessSummaryPanel"
                Grid.Row="3"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DeployOverallStateTextBlock"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Idle" />
                    <ProgressBar
                        x:Name="DeployProgressBar"
                        Grid.Column="1"
                        Height="12"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="DeployProgressSummaryTextBlock"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="No deployment started."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="DeployGlobalIssuesBadgeTextBlock"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellWarnBrush}"
                        FontWeight="SemiBold"
                        Text="Issues: 0" />
                    <TextBlock
                        x:Name="DeployReadinessSummaryTextBlock"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Visibility="Collapsed"
                        Text="Readiness summary" />
                </Grid>
            </Border>

            <Border
                Grid.Row="4"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Correction Actions (Placeholder)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="DeployResolveSuggestionsButton"
                            Content="Resolve Suggestions" />
                        <Button
                            x:Name="DeployOpenTemplateEditorButton"
                            Content="Open in Templates Editor" />
                        <Button
                            x:Name="DeployStartButton"
                            Content="Start Deploy" />
                    </StackPanel>
                    <TextBlock
                        x:Name="DeployActionStatusTextBlock"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="No action selected."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="5" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Expander
                    x:Name="DeployGlobalIssuesExpander"
                    Grid.Row="0"
                    IsExpanded="False">
                    <Expander.Header>
                        <TextBlock
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Global warnings / errors" />
                    </Expander.Header>
                    <Border
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ListView x:Name="DeployGlobalIssuesListView" SelectionMode="None" />
                    </Border>
                </Expander>

                <Border
                    Grid.Row="1"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ListView x:Name="DeployVmResultsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                                FontWeight="SemiBold"
                                                Text="{Binding VmName}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                Text="{Binding Status}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                Text="{Binding Summary}" />
                                        </Grid>
                                    </Expander.Header>
                                    <Border
                                        Padding="8"
                                        Margin="0,4,0,8"
                                        Background="{StaticResource ShellBackgroundBrush}"
                                        BorderBrush="{StaticResource ShellBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <ItemsControl ItemsSource="{Binding TimelineSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressRing
                                                            Grid.Column="0"
                                                            Width="14"
                                                            Height="14"
                                                            IsActive="{Binding IsRunning}"
                                                            Visibility="{Binding RunningIndicatorVisibility}" />
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                            Text="{Binding IconGlyph}"
                                                            Visibility="{Binding StaticIconVisibility}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                            Text="{Binding Label}"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
