<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployFromTemplateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="DeployTemplateSelectorComboBox"
                    Grid.Column="0"
                    PlaceholderText="Select a template" />
                <Button
                    x:Name="DeployReloadTemplatesButton"
                    Grid.Column="1"
                    MinWidth="86"
                    Content="Reload"
                    ToolTipService.ToolTip="Reload templates" />
                <Button
                    x:Name="DeployEvaluateReadinessButton"
                    Grid.Column="2"
                    Content="Review Readiness" />
            </Grid>

            <ScrollViewer
                x:Name="DeployFromTemplateWorkspaceScrollViewer"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <Border
                        x:Name="DeployReadinessSummaryPanel"
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="DeployOverallStateTextBlock"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Idle" />
                            <ProgressBar
                                x:Name="DeployProgressBar"
                                Grid.Column="1"
                                Height="12"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DeployProgressSummaryTextBlock"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="No deployment started."
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Spacing="4">
                                <Button
                                    x:Name="DeployOpenResultsPanelButton"
                                    Content="Open Progress / Results" />
                                <TextBlock
                                    x:Name="DeployResultsPanelSummaryTextBlock"
                                    HorizontalAlignment="Right"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    FontSize="12"
                                    Text="Use the side panel during or after deploy for progress and results." />
                            </StackPanel>
                            <TextBlock
                                x:Name="DeployGlobalIssuesBadgeTextBlock"
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Foreground="{StaticResource ShellWarnBrush}"
                                FontWeight="SemiBold"
                                Text="Issues: 0"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="DeployReadinessSummaryTextBlock"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Readiness summary" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="DeployV2ReviewPanel"
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="V2 Review and Resolve" />
                            <TextBlock
                                x:Name="DeployV2StatusTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="V2 planning has not run yet."
                                TextWrapping="Wrap" />

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Plan Summary" />
                                    <TextBlock x:Name="DeployV2PlanSummaryTextBlock" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Base Remote Access" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="Legacy script defaults are enabled for this V2 deploy unless you change them here."
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        x:Name="DeployV2EnableRemoteDesktopCheckBox"
                                        Content="Enable Remote Desktop"
                                        IsEnabled="False" />
                                    <CheckBox
                                        x:Name="DeployV2SetPrivateNetworkProfileCheckBox"
                                        Content="Set network profile to Private"
                                        IsEnabled="False" />
                                    <CheckBox
                                        x:Name="DeployV2DisableFirewallCheckBox"
                                        Content="Disable Windows Firewall" />
                                    <CheckBox
                                        x:Name="DeployV2DisableRdpNlaCheckBox"
                                        Content="Disable RDP NLA" />
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Blocking Items" />
                                    <ListView
                                        x:Name="DeployV2BlockersListView"
                                        MaxHeight="180"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Resolve Credential Slots" />
                                    <ListView
                                        x:Name="DeployV2CredentialSlotsListView"
                                        MaxHeight="180"
                                        SelectionMode="Single">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding SlotKey}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding PurposeSummary}" TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding AffectedVmSummary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        x:Name="DeployV2CredentialSlotEditorTextBlock"
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="Select a slot below to create or update its local value."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="DeployV2CredentialSlotUsernameTextBox"
                                            Grid.Column="0"
                                            Header="Username"
                                            PlaceholderText="User name" />
                                        <PasswordBox
                                            x:Name="DeployV2CredentialSlotPasswordBox"
                                            Grid.Column="1"
                                            Header="Password" />
                                        <Button
                                            x:Name="DeployV2SaveCredentialSlotButton"
                                            Grid.Column="2"
                                            VerticalAlignment="Bottom"
                                            Content="Save Slot" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Execution Waves" />
                                    <ListView
                                        x:Name="DeployV2WavesListView"
                                        MaxHeight="180"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Expander Header="Diagnostics Detail">
                                <Border
                                    Margin="0,8,0,0"
                                    Padding="8"
                                    Background="{StaticResource ShellBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <ListView
                                        x:Name="DeployV2DiagnosticsListView"
                                        MaxHeight="180"
                                        SelectionMode="None">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Template Review" />
                            <TextBlock
                                x:Name="DeployTemplateSummaryTextBlock"
                                Grid.Row="1"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Select a template to review deployment summary, shared blockers, and remediation paths."
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DeployTemplateRemediationTextBlock"
                                Grid.Row="2"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Use this surface to review readiness and choose the correct remediation path before deploy."
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Remediation and Deploy" />
                            <TextBlock
                                x:Name="DeploySharedIssuesSummaryTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Shared review items appear here when multiple VMs need the same remediation."
                                TextWrapping="Wrap" />
                            <ListView
                                x:Name="DeploySharedIssuesListView"
                                MaxHeight="160">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="DeployResolveSuggestionsButton"
                                    Content="Resolve Suggestions" />
                                <Button
                                    x:Name="DeployOpenTemplateEditorButton"
                                    Content="Fix in Templates Editor" />
                                <Button
                                    x:Name="DeployStartButton"
                                    Content="Start Deploy" />
                            </StackPanel>
                            <TextBlock
                                x:Name="DeployActionStatusTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="No action selected."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
