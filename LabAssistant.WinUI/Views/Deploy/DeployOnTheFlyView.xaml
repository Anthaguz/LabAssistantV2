<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployOnTheFlyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Foreground="{StaticResource ShellTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Quick Deploy" />

            <TextBlock
                Grid.Row="1"
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="Configure VM entries, evaluate readiness, resolve blockers, and start deploy when ready."
                TextWrapping="Wrap" />

            <Border
                x:Name="DeployOnTheFlyReadinessSummaryPanel"
                Grid.Row="2"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DeployOnTheFlyOverallStateTextBlock"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Idle" />
                    <ProgressBar
                        x:Name="DeployOnTheFlyProgressBar"
                        Grid.Column="1"
                        Height="12"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="DeployOnTheFlyProgressSummaryTextBlock"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="No deployment started."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="DeployOnTheFlyGlobalIssuesBadgeTextBlock"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellWarnBrush}"
                        FontWeight="SemiBold"
                        Text="Blocking: 0 | Warnings: 0" />
                    <TextBlock
                        x:Name="DeployOnTheFlyReadinessSummaryTextBlock"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Visibility="Collapsed"
                        Text="Readiness summary" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.0*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="DeployOnTheFlyVmEntriesPanel"
                    Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="VM Entries" />
                        <ListView
                            x:Name="DeployOnTheFlyVmEntriesListView"
                            Grid.Row="1"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="6,4"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="DeployOnTheFlyAddVmButton"
                                Content="Add VM" />
                            <Button
                                x:Name="DeployOnTheFlyRemoveVmButton"
                                Content="Remove VM" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="DeployOnTheFlyVmEditorPanel"
                    Grid.Column="1"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="VM Properties" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid RowSpacing="8" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Name" />
                                <TextBox
                                    x:Name="DeployOnTheFlyVmNameTextBox"
                                    Grid.Row="0"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Memory (MB)" />
                                <TextBox
                                    x:Name="DeployOnTheFlyVmMemoryTextBox"
                                    Grid.Row="1"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="CPU" />
                                <TextBox
                                    x:Name="DeployOnTheFlyVmCpuTextBox"
                                    Grid.Row="2"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Base disk" />
                                <ComboBox
                                    x:Name="DeployOnTheFlyVmVhdxCatalogComboBox"
                                    Grid.Row="3"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Switch" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                                    <ComboBox x:Name="DeployOnTheFlyVmSwitchComboBox" />
                                    <TextBlock
                                        x:Name="DeployOnTheFlyVmSwitchGuidanceTextBlock"
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        FontSize="12"
                                        Text="Switch selection is optional."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="DeployOnTheFlyVmVhdxGuidanceTextBlock"
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    FontSize="12"
                                    Text="Catalog-backed selection is preferred."
                                    TextWrapping="Wrap" />
                            </Grid>
                        </ScrollViewer>

                        <Button
                            x:Name="DeployOnTheFlyApplyVmChangesButton"
                            Grid.Row="2"
                            Content="Apply VM Changes"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Deployment Results" />

                        <ListView x:Name="DeployOnTheFlyVmResultsListView" Grid.Row="1" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10,8"
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="{StaticResource ShellBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Background="{StaticResource ShellBackgroundBrush}"
                                            Visibility="{Binding FlatCardVisibility}">
                                            <Grid RowSpacing="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding VmName}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                        Text="{Binding Status}" />
                                                </Grid>
                                                <ProgressBar
                                                    Grid.Row="1"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding ProgressPercent}"
                                                    Height="6" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                    Text="{Binding DisplaySummary}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{Binding SummaryVisibility}" />
                                            </Grid>
                                        </Border>

                                        <Expander
                                            IsExpanded="False"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="{StaticResource ShellBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Background="{StaticResource ShellBackgroundBrush}"
                                            Visibility="{Binding ExpanderVisibility}">
                                            <Expander.Header>
                                                <Grid Padding="10,8" RowSpacing="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding VmName}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                            Text="{Binding Status}" />
                                                    </Grid>
                                                    <ProgressBar
                                                        Grid.Row="1"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding ProgressPercent}"
                                                        Height="6" />
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                        Text="{Binding DisplaySummary}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding SummaryVisibility}" />
                                                </Grid>
                                            </Expander.Header>
                                            <Border
                                                Padding="10,8"
                                                Margin="8,0,8,8"
                                                Background="{StaticResource ShellContentBackgroundBrush}"
                                                BorderBrush="{StaticResource ShellBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <ItemsControl ItemsSource="{Binding TimelineSteps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4" ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <ProgressRing
                                                                    Grid.Column="0"
                                                                    Width="14"
                                                                    Height="14"
                                                                    IsActive="{Binding IsRunning}"
                                                                    Visibility="{Binding RunningIndicatorVisibility}" />
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                                    Text="{Binding IconGlyph}"
                                                                    Visibility="{Binding StaticIconVisibility}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                                    Text="{Binding Label}"
                                                                    TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Expander>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Row="4"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="DeployOnTheFlyEvaluateButton"
                            Content="Evaluate" />
                        <Button
                            x:Name="DeployOnTheFlyResolveSuggestionsButton"
                            Content="Resolve Suggestions" />
                        <Button
                            x:Name="DeployOnTheFlyOpenTemplateEditorButton"
                            Content="Open in Templates Editor" />
                        <Button
                            x:Name="DeployOnTheFlyStartButton"
                            Content="Start Deploy" />
                    </StackPanel>
                    <TextBlock
                        x:Name="DeployOnTheFlyStatusTextBlock"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Ready."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
