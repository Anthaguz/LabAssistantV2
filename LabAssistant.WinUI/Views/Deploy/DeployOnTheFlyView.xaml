<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployOnTheFlyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                x:Name="DeployOnTheFlyReadinessSummaryPanel"
                Grid.Row="0"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DeployOnTheFlyOverallStateTextBlock"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Idle" />
                    <ProgressBar
                        x:Name="DeployOnTheFlyProgressBar"
                        Grid.Column="1"
                        Height="12"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="DeployOnTheFlyProgressSummaryTextBlock"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="No deployment started."
                        TextWrapping="Wrap" />
                    <StackPanel
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        Spacing="4">
                        <Button
                            x:Name="DeployOnTheFlyOpenResultsPanelButton"
                            Content="Open Progress / Results" />
                        <TextBlock
                            x:Name="DeployOnTheFlyResultsPanelSummaryTextBlock"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            FontSize="12"
                            Text="Use the side panel during or after deploy for progress and results." />
                    </StackPanel>
                    <TextBlock
                        x:Name="DeployOnTheFlyGlobalIssuesBadgeTextBlock"
                        Grid.Column="3"
                        Foreground="{StaticResource ShellWarnBrush}"
                        FontWeight="SemiBold"
                        Text="Blocking: 0 | Warnings: 0"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="DeployOnTheFlyReadinessSummaryTextBlock"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Readiness summary" />
                </Grid>
            </Border>

            <Grid
                x:Name="DeployOnTheFlyWorkspaceGrid"
                Grid.Row="1"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DeployOnTheFlyListColumnDefinition" Width="1.05*" />
                    <ColumnDefinition x:Name="DeployOnTheFlyEditorColumnDefinition" Width="1.25*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DeployOnTheFlyPrimaryRowDefinition" Height="*" />
                    <RowDefinition x:Name="DeployOnTheFlyEditorRowDefinition" Height="0" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DeployOnTheFlyVmEntriesPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="VM Entries" />
                        <ListView
                            x:Name="DeployOnTheFlyVmEntriesListView"
                            Grid.Row="1"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                                FontWeight="SemiBold"
                                                Text="{Binding DisplayName}" />
                                            <TextBlock
                                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                FontSize="12"
                                                Text="{Binding SecondaryText}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{Binding IssueBrush}"
                                                FontSize="12"
                                                Text="{Binding IssueSummary}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding IssueSummaryVisibility}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            Padding="8,3"
                                            Background="{StaticResource ShellContentBackgroundBrush}"
                                            BorderBrush="{StaticResource ShellBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IssueBadgeVisibility}">
                                            <TextBlock
                                                Foreground="{Binding IssueBrush}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding IssueBadgeText}" />
                                        </Border>

                                        <Button
                                            Grid.Column="2"
                                            Click="DeployOnTheFlyRowRemoveButton_Click"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Tag="{Binding VmEntry}"
                                            ToolTipService.ToolTip="Remove VM"
                                            VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="DeployOnTheFlyAddVmButton"
                                Width="32"
                                Height="32"
                                Padding="0"
                                HorizontalAlignment="Left"
                                ToolTipService.ToolTip="Add VM">
                                <FontIcon Glyph="&#xE710;" />
                            </Button>
                            <Button
                                x:Name="DeployOnTheFlyRemoveVmButton"
                                Content="Remove VM"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="DeployOnTheFlyVmEditorPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="VM Properties" />

                        <TextBlock
                            x:Name="DeployOnTheFlyEditorIssueSummaryTextBlock"
                            Grid.Row="1"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="Changes validate while you edit. Row signals show which VM needs attention."
                            TextWrapping="Wrap" />

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid RowSpacing="8" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Name" />
                                <TextBox
                                    x:Name="DeployOnTheFlyVmNameTextBox"
                                    Grid.Row="0"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Memory (MB)" />
                                <TextBox
                                    x:Name="DeployOnTheFlyVmMemoryTextBox"
                                    Grid.Row="1"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="CPU" />
                                <TextBox
                                    x:Name="DeployOnTheFlyVmCpuTextBox"
                                    Grid.Row="2"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Base disk" />
                                <ComboBox
                                    x:Name="DeployOnTheFlyVmVhdxCatalogComboBox"
                                    Grid.Row="3"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Switch" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                                    <ComboBox x:Name="DeployOnTheFlyVmSwitchComboBox" />
                                    <TextBlock
                                        x:Name="DeployOnTheFlyVmSwitchGuidanceTextBlock"
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        FontSize="12"
                                        Text="Switch selection is optional."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="DeployOnTheFlyVmVhdxGuidanceTextBlock"
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    FontSize="12"
                                    Text="Catalog-backed selection is preferred."
                                    TextWrapping="Wrap" />
                            </Grid>
                        </ScrollViewer>

                        <Button
                            x:Name="DeployOnTheFlyApplyVmChangesButton"
                            Grid.Row="3"
                            Content="Apply VM Changes"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

            </Grid>

            <Border
                Grid.Row="2"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="DeployOnTheFlyEvaluateButton"
                            Content="Evaluate"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="DeployOnTheFlyResolveSuggestionsButton"
                            Content="Resolve Suggestions" />
                        <Button
                            x:Name="DeployOnTheFlyOpenTemplateEditorButton"
                            Content="Open in Templates Editor" />
                        <Button
                            x:Name="DeployOnTheFlyStartButton"
                            Content="Start Deploy" />
                    </StackPanel>
                    <TextBlock
                        x:Name="DeployOnTheFlyStatusTextBlock"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Ready."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
