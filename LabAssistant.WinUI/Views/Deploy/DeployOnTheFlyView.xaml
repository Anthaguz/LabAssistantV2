<UserControl
    x:Class="LabAssistant.WinUI.Views.Deploy.DeployOnTheFlyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Foreground="{StaticResource ShellTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Deploy On-the-Fly" />

            <TextBlock
                Grid.Row="1"
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="Configure VM entries, evaluate readiness, apply corrections, and start deploy when unblocked."
                TextWrapping="Wrap" />

            <Border
                x:Name="DeployOnTheFlyReadinessSummaryPanel"
                Grid.Row="2"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="DeployOnTheFlyOverallStateTextBlock"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Idle" />
                    <ProgressBar
                        x:Name="DeployOnTheFlyProgressBar"
                        Grid.Column="1"
                        Height="12"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="DeployOnTheFlyProgressSummaryTextBlock"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="No deployment started."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="DeployOnTheFlyGlobalIssuesBadgeTextBlock"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellWarnBrush}"
                        FontWeight="SemiBold"
                        Text="Issues: 0" />
                    <TextBlock
                        x:Name="DeployOnTheFlyReadinessSummaryTextBlock"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Visibility="Collapsed"
                        Text="Readiness summary" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="DeployOnTheFlyVmEntriesPanel"
                    Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="VM Entries" />
                        <ListView
                            x:Name="DeployOnTheFlyVmEntriesListView"
                            Grid.Row="1"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="2">
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding VmId}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="DeployOnTheFlyAddVmButton"
                                Content="Add VM" />
                            <Button
                                x:Name="DeployOnTheFlyRemoveVmButton"
                                Content="Remove VM" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="DeployOnTheFlyVmEditorPanel"
                    Grid.Column="1"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8" ColumnSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="Name" />
                        <TextBox
                            x:Name="DeployOnTheFlyVmNameTextBox"
                            Grid.Row="0"
                            Grid.Column="1" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="Memory (MB)" />
                        <TextBox
                            x:Name="DeployOnTheFlyVmMemoryTextBox"
                            Grid.Row="1"
                            Grid.Column="1" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="CPU" />
                        <TextBox
                            x:Name="DeployOnTheFlyVmCpuTextBox"
                            Grid.Row="2"
                            Grid.Column="1" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="VHD path" />
                        <TextBox
                            x:Name="DeployOnTheFlyVmVhdPathTextBox"
                            Grid.Row="3"
                            Grid.Column="1" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="Switches" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                            <TextBox x:Name="DeployOnTheFlyVmSwitchesTextBox" />
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                FontSize="12"
                                Text="Comma-separated switch names. Optional."
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="DeployOnTheFlyApplyVmChangesButton"
                                Content="Apply VM Changes"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Row="4"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="DeployOnTheFlyEvaluateButton"
                            Content="Evaluate" />
                        <Button
                            x:Name="DeployOnTheFlyResolveSuggestionsButton"
                            Content="Resolve Suggestions" />
                        <Button
                            x:Name="DeployOnTheFlyOpenTemplateEditorButton"
                            Content="Open in Templates Editor" />
                        <Button
                            x:Name="DeployOnTheFlyStartButton"
                            Content="Start Deploy" />
                    </StackPanel>
                    <TextBlock
                        x:Name="DeployOnTheFlyStatusTextBlock"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Ready."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="5" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Expander
                    x:Name="DeployOnTheFlyGlobalIssuesExpander"
                    Grid.Row="0"
                    IsExpanded="False">
                    <Expander.Header>
                        <TextBlock
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Global warnings / errors" />
                    </Expander.Header>
                    <Border
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ListView x:Name="DeployOnTheFlyGlobalIssuesListView" SelectionMode="None" />
                    </Border>
                </Expander>

                <Border
                    Grid.Row="1"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ListView x:Name="DeployOnTheFlyVmResultsListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                                FontWeight="SemiBold"
                                                Text="{Binding VmName}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                Text="{Binding Status}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                Text="{Binding Summary}" />
                                        </Grid>
                                    </Expander.Header>
                                    <Border
                                        Padding="8"
                                        Margin="0,4,0,8"
                                        Background="{StaticResource ShellBackgroundBrush}"
                                        BorderBrush="{StaticResource ShellBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding Details}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
