<UserControl
    x:Class="LabAssistant.WinUI.Views.Machines.MachinesOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="MachinesOverviewPanel" x:FieldModifier="public">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="8"
            Background="{StaticResource ShellBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Host VMs" />
                    <Button
                        x:Name="RefreshMachinesButton"
                        x:FieldModifier="public"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Refresh machine inventory">
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
                <ListView
                    x:Name="MachinesListView"
                    x:FieldModifier="public"
                    Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                    Text="{Binding VmName}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="{Binding State}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="{Binding OriginLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border
            Grid.Column="2"
            Padding="12"
            Background="{StaticResource ShellBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="VM Details" />
                <TextBlock x:Name="SelectedVmNameTextBlock" x:FieldModifier="public" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Name: (none)" />
                <TextBlock x:Name="SelectedVmStateTextBlock" x:FieldModifier="public" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="State: -" />
                <TextBlock x:Name="SelectedVmOriginTextBlock" x:FieldModifier="public" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Origin: -" />
                <TextBlock x:Name="SelectedVmIdTextBlock" x:FieldModifier="public" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="VM Id: -" TextWrapping="Wrap" />
                <TextBlock x:Name="SelectedVmPathTextBlock" x:FieldModifier="public" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Path: -" TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontWeight="SemiBold"
                    Text="Basic Edit" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="CPU Count" />
                    <TextBox x:Name="CpuCountTextBox" x:FieldModifier="public" Grid.Column="1" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Startup Memory (MB)" />
                    <TextBox x:Name="StartupMemoryTextBox" x:FieldModifier="public" Grid.Column="1" />
                </Grid>

                <ToggleSwitch x:Name="DynamicMemoryToggle" x:FieldModifier="public" Header="Dynamic Memory" />

                <Grid x:Name="DynamicMemoryPanel" x:FieldModifier="public" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Min (MB)" />
                    <TextBox x:Name="MinimumMemoryTextBox" x:FieldModifier="public" Grid.Row="0" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Max (MB)" />
                    <TextBox x:Name="MaximumMemoryTextBox" x:FieldModifier="public" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Buffer (%)" />
                    <TextBox x:Name="MemoryBufferTextBox" x:FieldModifier="public" Grid.Row="2" Grid.Column="1" />
                </Grid>

                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Network Adapters" />
                <StackPanel x:Name="NetworkAdapterEditorPanel" x:FieldModifier="public" Spacing="6" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ApplyMachineEditsButton"
                        x:FieldModifier="public"
                        Width="32"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Apply machine changes">
                        <FontIcon Glyph="&#xE74E;" />
                    </Button>
                    <TextBlock
                        x:Name="MachineEditDirtyTextBlock"
                        x:FieldModifier="public"
                        Foreground="{StaticResource ShellWarnBrush}"
                        VerticalAlignment="Center"
                        Text="Unsaved changes"
                        Visibility="Collapsed" />
                </StackPanel>

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontWeight="SemiBold"
                    Text="Actions" />
                <StackPanel Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            FontSize="12"
                            Text="Power" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartVmButton" x:FieldModifier="public" Content="Start VM" />
                            <Button x:Name="StopVmButton" x:FieldModifier="public" Content="Stop VM" />
                            <Button x:Name="RestartVmButton" x:FieldModifier="public" Content="Restart VM" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            FontSize="12"
                            Text="Remote access" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenConsoleButton" x:FieldModifier="public" Content="Open Console" />
                            <Button x:Name="OpenRdpButton" x:FieldModifier="public" IsEnabled="False" Content="Open RDP" />
                            <Button
                                x:Name="DeleteVmButton"
                                x:FieldModifier="public"
                                Width="32"
                                Height="32"
                                Padding="0"
                                ToolTipService.ToolTip="Delete virtual machine">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    x:Name="RdpReadinessTextBlock"
                    x:FieldModifier="public"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    FontStyle="Italic"
                    Text="RDP readiness unknown."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="MachinesStatusTextBlock"
                    x:FieldModifier="public"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="Select a VM to run actions."
                    TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
