<UserControl
    x:Class="LabAssistant.WinUI.Views.Machines.MachinesOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LabAssistant.WinUI.ViewModels.Machines">
    <UserControl.Resources>
        <Style x:Key="InlineCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{StaticResource ShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <Grid
        ColumnSpacing="12"
        AutomationProperties.LandmarkType="Main"
        XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Style="{StaticResource InlineCardBorderStyle}"
            AutomationProperties.LandmarkType="Navigation">
            <Grid RowSpacing="8" XYFocusKeyboardNavigation="Enabled">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Host VMs" />
                    <Button
                        Padding="12,6"
                        TabIndex="0"
                        AccessKey="R"
                        AutomationProperties.Name="Refresh virtual machines"
                        AutomationProperties.HelpText="Reload the list of Hyper-V virtual machines."
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Content="Refresh" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    TabIndex="1"
                    AutomationProperties.Name="Virtual machines list"
                    AutomationProperties.HelpText="Browse and select a virtual machine to review details and actions."
                    ItemsSource="{x:Bind ViewModel.Machines, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMachine, Mode=TwoWay}"
                    XYFocusKeyboardNavigation="Enabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MachineListItem">
                            <Grid Padding="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{x:Bind VmName}" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind State}" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind OriginLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Style="{StaticResource InlineCardBorderStyle}"
            AutomationProperties.LandmarkType="Form">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="VM Details" />

                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedVmNameText, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmStateText, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmOriginText, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmIdText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmPathText, Mode=OneWay}" TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Basic Edit" />

                    <Grid ColumnSpacing="8" XYFocusKeyboardNavigation="Enabled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CpuCountLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="CPU Count" />
                        <TextBox
                            Grid.Column="1"
                            TabIndex="2"
                            AutomationProperties.Name="CPU count"
                            AutomationProperties.HelpText="Edit the number of virtual processors for the selected virtual machine."
                            AutomationProperties.LabeledBy="{Binding ElementName=CpuCountLabel}"
                            IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                            Text="{x:Bind ViewModel.CpuCount, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="8" XYFocusKeyboardNavigation="Enabled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StartupMemoryLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Startup Memory (MB)" />
                        <TextBox
                            Grid.Column="1"
                            TabIndex="3"
                            AutomationProperties.Name="Startup memory in megabytes"
                            AutomationProperties.HelpText="Edit the startup memory for the selected virtual machine."
                            AutomationProperties.LabeledBy="{Binding ElementName=StartupMemoryLabel}"
                            IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                            Text="{x:Bind ViewModel.StartupMemory, Mode=TwoWay}" />
                    </Grid>

                    <ToggleSwitch
                        Header="Dynamic Memory"
                        TabIndex="4"
                        AutomationProperties.Name="Dynamic memory"
                        AutomationProperties.HelpText="Turn dynamic memory on or off for the selected virtual machine."
                        IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsDynamicMemory, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Padding="12,6"
                            TabIndex="5"
                            AccessKey="S"
                            AutomationProperties.Name="Save virtual machine changes"
                            AutomationProperties.HelpText="Save pending edits for the selected virtual machine."
                            IsEnabled="{x:Bind ViewModel.CanSaveChanges, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SaveChangesCommand}"
                            Content="Save Changes" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellWarnBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            Text="Unsaved changes" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Actions" />
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" FontSize="12" Text="Power" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button TabIndex="6" AccessKey="T" AutomationProperties.Name="Start virtual machine" AutomationProperties.HelpText="Start the selected virtual machine." IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}" Command="{x:Bind ViewModel.StartVmCommand}" Content="Start VM" />
                                <Button TabIndex="7" AccessKey="O" AutomationProperties.Name="Stop virtual machine" AutomationProperties.HelpText="Stop the selected virtual machine." IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}" Command="{x:Bind ViewModel.StopVmCommand}" Content="Stop VM" />
                                <Button TabIndex="8" AccessKey="E" AutomationProperties.Name="Restart virtual machine" AutomationProperties.HelpText="Restart the selected virtual machine." IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}" Command="{x:Bind ViewModel.RestartVmCommand}" Content="Restart VM" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" FontSize="12" Text="Remote access" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button TabIndex="9" AccessKey="C" AutomationProperties.Name="Open console" AutomationProperties.HelpText="Open the console for the selected virtual machine." IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}" Command="{x:Bind ViewModel.OpenConsoleCommand}" Content="Open Console" />
                                <Button TabIndex="10" AccessKey="P" AutomationProperties.Name="Open Remote Desktop" AutomationProperties.HelpText="Open a Remote Desktop connection for the selected virtual machine when available." IsEnabled="{x:Bind ViewModel.CanOpenRdp, Mode=OneWay}" Command="{x:Bind ViewModel.OpenRdpCommand}" Content="Open RDP" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" FontSize="12" Text="Delete" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Padding="12,6"
                                    TabIndex="11"
                                    AccessKey="D"
                                    AutomationProperties.Name="Delete virtual machine"
                                    AutomationProperties.HelpText="Delete the selected virtual machine."
                                    IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.DeleteVmCommand}"
                                    Foreground="{StaticResource ShellWarnBrush}"
                                    Content="Delete VM" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.RdpReadinessText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
