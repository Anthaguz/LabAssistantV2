<UserControl
    x:Class="LabAssistant.WinUI.Views.Machines.MachinesOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LabAssistant.WinUI.ViewModels.Machines">
    <UserControl.Resources>
        <Style x:Key="InlineCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{StaticResource ShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource InlineCardBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Host VMs" />
                    <Button
                        Padding="12,6"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Content="Refresh" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Machines, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedMachine, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MachineListItem">
                            <Grid Padding="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{x:Bind VmName}" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind State}" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind OriginLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource InlineCardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="VM Details" />

                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedVmNameText, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmStateText, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmOriginText, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmIdText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmPathText, Mode=OneWay}" TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Basic Edit" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="CPU Count" />
                        <TextBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}" Text="{x:Bind ViewModel.CpuCount, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Startup Memory (MB)" />
                        <TextBox Grid.Column="1" IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}" Text="{x:Bind ViewModel.StartupMemory, Mode=TwoWay}" />
                    </Grid>

                    <ToggleSwitch
                        Header="Dynamic Memory"
                        IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsDynamicMemory, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Padding="12,6"
                            IsEnabled="{x:Bind ViewModel.CanSaveChanges, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SaveChangesCommand}"
                            Content="Save Changes" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellWarnBrush}"
                            Text="Unsaved changes" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Actions" />
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" FontSize="12" Text="Power" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}" Command="{x:Bind ViewModel.StartVmCommand}" Content="Start VM" />
                                <Button IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}" Command="{x:Bind ViewModel.StopVmCommand}" Content="Stop VM" />
                                <Button IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}" Command="{x:Bind ViewModel.RestartVmCommand}" Content="Restart VM" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" FontSize="12" Text="Remote access" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}" Command="{x:Bind ViewModel.OpenConsoleCommand}" Content="Open Console" />
                                <Button IsEnabled="{x:Bind ViewModel.CanOpenRdp, Mode=OneWay}" Command="{x:Bind ViewModel.OpenRdpCommand}" Content="Open RDP" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" FontSize="12" Text="Delete" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Padding="12,6"
                                    IsEnabled="{x:Bind ViewModel.CanRunMachineActions, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.DeleteVmCommand}"
                                    Foreground="{StaticResource ShellWarnBrush}"
                                    Content="Delete VM" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.RdpReadinessText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
