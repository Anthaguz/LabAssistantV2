<UserControl
    x:Class="LabAssistant.WinUI.Views.Machines.MachinesOverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LabAssistant.WinUI.ViewModels.Machines"
    xmlns:converters="using:LabAssistant.WinUI.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            Local action-button affordance styles (F21). Scoped to this view so the global palette
            and theme dictionaries are untouched; they only compose existing shell palette brushes.
        -->
        <Style x:Key="MachineActionIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource ShellTextPrimaryBrush}" />
        </Style>
        <Style x:Key="MachinePrimaryActionIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MachineActionIconButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ShellAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="MachineDestructiveActionIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MachineActionIconButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource ShellCriticalBrush}" />
        </Style>

        <Style x:Key="InlineCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            <Setter Property="Background" Value="{StaticResource ShellBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <Grid
        ColumnSpacing="{StaticResource SpacingM}"
        AutomationProperties.LandmarkType="Main"
        XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Style="{StaticResource InlineCardBorderStyle}"
            AutomationProperties.LandmarkType="Navigation">
            <Grid RowSpacing="{StaticResource SpacingS}" XYFocusKeyboardNavigation="Enabled">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="{StaticResource SpacingS}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Virtual Machines" />
                    <Button
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        TabIndex="0"
                        AccessKey="R"
                        AutomationProperties.Name="Refresh virtual machines"
                        AutomationProperties.HelpText="Reload the list of Hyper-V virtual machines."
                        ToolTipService.ToolTip="Refresh virtual machines"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshCommand}">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <ListView
                    x:Name="MachinesListView"
                    Grid.Row="1"
                    TabIndex="1"
                    SelectionMode="Extended"
                    AutomationProperties.Name="Virtual machines list"
                    AutomationProperties.HelpText="Browse and select virtual machines. Use Ctrl or Shift click to select several for a bulk action."
                    ItemsSource="{x:Bind ViewModel.Machines, Mode=OneWay}"
                    SelectionChanged="OnMachinesSelectionChanged"
                    XYFocusKeyboardNavigation="Enabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:MachineListItem">
                            <Grid Padding="6" ColumnSpacing="{StaticResource SpacingS}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{x:Bind VmName}" />
                                <TextBlock Grid.Column="1" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind State}" />
                                <TextBlock Grid.Column="2" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind OriginLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Border
            Grid.Column="1"
            Style="{StaticResource InlineCardBorderStyle}"
            AutomationProperties.LandmarkType="Form">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="VM Details" />

                    <!--
                        Selection-driven panels (F07). The hint shows when nothing is selected; the
                        single-VM section (details, edit form, console/RDP, rename) shows only for a
                        single selection; the bulk action group shows whenever one or more are selected.
                    -->
                    <TextBlock
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.ShowSelectionHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        Text="Select one or more VMs. Use Ctrl or Shift click for a bulk action." />

                    <StackPanel
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.ShowSingleMachineControls, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedVmNameText, Mode=OneWay}" />
                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedVmOriginText, Mode=OneWay}" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Basic Edit" />

                    <Grid ColumnSpacing="{StaticResource SpacingS}" XYFocusKeyboardNavigation="Enabled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CpuCountLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="CPU Count" />
                        <TextBox
                            Grid.Column="1"
                            Width="90"
                            HorizontalAlignment="Left"
                            TabIndex="2"
                            AutomationProperties.Name="CPU count"
                            AutomationProperties.HelpText="Edit the number of virtual processors for the selected virtual machine."
                            AutomationProperties.LabeledBy="{Binding ElementName=CpuCountLabel}"
                            IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                            Text="{x:Bind ViewModel.CpuCount, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnSpacing="{StaticResource SpacingS}" XYFocusKeyboardNavigation="Enabled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StartupMemoryLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Startup Memory (MB)" />
                        <TextBox
                            Grid.Column="1"
                            Width="140"
                            HorizontalAlignment="Left"
                            TabIndex="3"
                            AutomationProperties.Name="Startup memory in megabytes"
                            AutomationProperties.HelpText="Edit the startup memory for the selected virtual machine."
                            AutomationProperties.LabeledBy="{Binding ElementName=StartupMemoryLabel}"
                            IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                            Text="{x:Bind ViewModel.StartupMemory, Mode=TwoWay}" />
                    </Grid>

                    <ToggleSwitch
                        Header="Dynamic Memory"
                        TabIndex="4"
                        AutomationProperties.Name="Dynamic memory"
                        AutomationProperties.HelpText="Turn dynamic memory on or off for the selected virtual machine."
                        IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsDynamicMemory, Mode=TwoWay}" />

                    <!--
                        Minimum/maximum/buffer only apply to dynamic memory, so they are shown only
                        while it is on (F16). With dynamic memory off the guest uses a fixed Startup
                        allocation and these fields would be meaningless.
                    -->
                    <StackPanel
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.ShowDynamicMemoryFields, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid ColumnSpacing="{StaticResource SpacingS}" XYFocusKeyboardNavigation="Enabled">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MinMemoryLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Minimum Memory (MB)" />
                            <TextBox
                                Grid.Column="1"
                                Width="140"
                                HorizontalAlignment="Left"
                                TabIndex="5"
                                AutomationProperties.Name="Minimum memory in megabytes"
                                AutomationProperties.HelpText="Edit the minimum dynamic memory for the selected virtual machine."
                                AutomationProperties.LabeledBy="{Binding ElementName=MinMemoryLabel}"
                                IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                                Text="{x:Bind ViewModel.MinMemory, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource SpacingS}" XYFocusKeyboardNavigation="Enabled">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MaxMemoryLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Maximum Memory (MB)" />
                            <TextBox
                                Grid.Column="1"
                                Width="140"
                                HorizontalAlignment="Left"
                                TabIndex="6"
                                AutomationProperties.Name="Maximum memory in megabytes"
                                AutomationProperties.HelpText="Edit the maximum dynamic memory for the selected virtual machine."
                                AutomationProperties.LabeledBy="{Binding ElementName=MaxMemoryLabel}"
                                IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                                Text="{x:Bind ViewModel.MaxMemory, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource SpacingS}" XYFocusKeyboardNavigation="Enabled">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MemoryBufferLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Memory Buffer (%)" />
                            <TextBox
                                Grid.Column="1"
                                Width="90"
                                HorizontalAlignment="Left"
                                TabIndex="7"
                                AutomationProperties.Name="Memory buffer percent"
                                AutomationProperties.HelpText="Edit the dynamic memory buffer percentage for the selected virtual machine."
                                AutomationProperties.LabeledBy="{Binding ElementName=MemoryBufferLabel}"
                                IsEnabled="{x:Bind ViewModel.CanEditMachine, Mode=OneWay}"
                                Text="{x:Bind ViewModel.MemoryBuffer, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                        <Button
                            Padding="12,6"
                            TabIndex="8"
                            AccessKey="S"
                            AutomationProperties.Name="Save virtual machine changes"
                            AutomationProperties.HelpText="Save pending edits for the selected virtual machine."
                            IsEnabled="{x:Bind ViewModel.CanSaveChanges, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SaveChangesCommand}"
                            Content="Save Changes" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellWarnBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="{x:Bind ViewModel.HasDirtyEdits, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                            Text="Unsaved changes" />
                    </StackPanel>

                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Actions" />
                        <StackPanel Spacing="{StaticResource SpacingS}">
                            <StackPanel Spacing="{StaticResource SpacingXS}">
                                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" FontSize="12" Text="Remote access" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                                    <Button
                                        Style="{StaticResource MachineActionIconButtonStyle}"
                                        TabIndex="13"
                                        AccessKey="C"
                                        AutomationProperties.Name="Open console"
                                        AutomationProperties.HelpText="Open the console for the selected virtual machine."
                                        ToolTipService.ToolTip="Open console"
                                        IsEnabled="{x:Bind ViewModel.CanRunSingleMachineActions, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.OpenConsoleCommand}">
                                        <FontIcon FontSize="16" Glyph="&#xE756;" />
                                    </Button>
                                    <!--
                                        The RDP reason lives on a wrapper Grid so the tooltip still surfaces
                                        while the button itself is disabled (a disabled button is not
                                        hit-testable and would otherwise swallow the hover) (F22).
                                    -->
                                    <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.RdpActionTooltip, Mode=OneWay}">
                                        <Button
                                            Style="{StaticResource MachineActionIconButtonStyle}"
                                            TabIndex="14"
                                            AccessKey="P"
                                            AutomationProperties.Name="Open Remote Desktop"
                                            AutomationProperties.HelpText="Open a Remote Desktop connection for the selected virtual machine when available."
                                            IsEnabled="{x:Bind ViewModel.CanOpenRdp, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.OpenRdpCommand}">
                                            <FontIcon FontSize="16" Glyph="&#xE8AF;" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="{StaticResource SpacingXS}">
                                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" FontSize="12" Text="Manage" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                                    <Button
                                        Style="{StaticResource MachineActionIconButtonStyle}"
                                        TabIndex="15"
                                        AccessKey="N"
                                        AutomationProperties.Name="Rename virtual machine"
                                        AutomationProperties.HelpText="Rename the selected virtual machine."
                                        ToolTipService.ToolTip="Rename VM"
                                        IsEnabled="{x:Bind ViewModel.CanRunSingleMachineActions, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.RenameVmCommand}">
                                        <FontIcon FontSize="16" Glyph="&#xE8AC;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!--
                        Bulk actions (F07). Visible whenever one or more VMs are selected; each action
                        runs across the whole selection. The Power group and Delete are bulk-capable,
                        so they intentionally stay available for a single selection too.
                    -->
                    <StackPanel
                        Spacing="{StaticResource SpacingS}"
                        Visibility="{x:Bind ViewModel.ShowBulkActions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Actions" />
                        <TextBlock
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            FontSize="12"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.SelectionSummaryText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                            <Button
                                Style="{StaticResource MachinePrimaryActionIconButtonStyle}"
                                TabIndex="9"
                                AccessKey="T"
                                AutomationProperties.Name="Start virtual machines"
                                AutomationProperties.HelpText="Start every selected virtual machine."
                                ToolTipService.ToolTip="Start"
                                IsEnabled="{x:Bind ViewModel.CanRunBulkActions, Mode=OneWay}"
                                Command="{x:Bind ViewModel.StartVmCommand}">
                                <FontIcon FontSize="16" Glyph="&#xE768;" />
                            </Button>
                            <Button
                                Style="{StaticResource MachineActionIconButtonStyle}"
                                TabIndex="10"
                                AccessKey="O"
                                AutomationProperties.Name="Shut down virtual machines"
                                AutomationProperties.HelpText="Request a graceful guest shutdown of every selected virtual machine."
                                ToolTipService.ToolTip="Shut down (guest OS)"
                                IsEnabled="{x:Bind ViewModel.CanRunBulkActions, Mode=OneWay}"
                                Command="{x:Bind ViewModel.StopVmCommand}">
                                <FontIcon FontSize="16" Glyph="&#xE7E8;" />
                            </Button>
                            <Button
                                Style="{StaticResource MachineActionIconButtonStyle}"
                                TabIndex="11"
                                AccessKey="F"
                                AutomationProperties.Name="Turn off virtual machines"
                                AutomationProperties.HelpText="Hard power-off every selected virtual machine without waiting for the guest to shut down."
                                ToolTipService.ToolTip="Turn off (hard power-off)"
                                IsEnabled="{x:Bind ViewModel.CanRunBulkActions, Mode=OneWay}"
                                Command="{x:Bind ViewModel.TurnOffVmCommand}">
                                <FontIcon FontSize="16" Glyph="&#xE71A;" />
                            </Button>
                            <Button
                                Style="{StaticResource MachineActionIconButtonStyle}"
                                TabIndex="12"
                                AccessKey="E"
                                AutomationProperties.Name="Restart virtual machines"
                                AutomationProperties.HelpText="Restart every selected virtual machine."
                                ToolTipService.ToolTip="Restart"
                                IsEnabled="{x:Bind ViewModel.CanRunBulkActions, Mode=OneWay}"
                                Command="{x:Bind ViewModel.RestartVmCommand}">
                                <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                Style="{StaticResource MachineDestructiveActionIconButtonStyle}"
                                TabIndex="16"
                                AccessKey="D"
                                AutomationProperties.Name="Delete virtual machines"
                                AutomationProperties.HelpText="Delete every selected virtual machine."
                                ToolTipService.ToolTip="Delete"
                                IsEnabled="{x:Bind ViewModel.CanRunBulkActions, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DeleteVmCommand}">
                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
