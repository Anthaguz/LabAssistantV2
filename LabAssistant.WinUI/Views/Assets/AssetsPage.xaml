<Page
    x:Class="LabAssistant.WinUI.Views.Assets.AssetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assetsViews="using:LabAssistant.WinUI.Views.Assets">
    <TabView
        x:Name="SubviewTabView"
        IsAddTabButtonVisible="False"
        SelectionChanged="SubviewTabView_SelectionChanged">
        <TabViewItem x:Name="OverviewTabViewItem" Header="Overview" IsClosable="False">
            <assetsViews:AssetsOverviewView x:Name="OverviewViewHost" />
        </TabViewItem>
        <TabViewItem x:Name="BaseDisksTabViewItem" Header="Base Disks" IsClosable="False">
            <assetsViews:AssetsBaseDisksView x:Name="BaseDisksViewHost" />
        </TabViewItem>
        <TabViewItem x:Name="SwitchesTabViewItem" Header="Switches" IsClosable="False">
            <assetsViews:AssetsSwitchesView x:Name="SwitchesViewHost" />
        </TabViewItem>
    </TabView>
</Page>
