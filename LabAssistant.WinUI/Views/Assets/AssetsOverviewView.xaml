<UserControl
    x:Class="LabAssistant.WinUI.Views.Assets.AssetsOverviewView"
    x:Name="AssetsOverviewViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        RowSpacing="12"
        AutomationProperties.LandmarkType="Main"
        XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Spacing="8"
            AutomationProperties.LandmarkType="Custom"
            AutomationProperties.LocalizedLandmarkType="Asset status">
            <TextBlock
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}"
                TextWrapping="Wrap" />
            <ProgressRing
                Width="24"
                Height="24"
                AutomationProperties.Name="Loading asset catalog"
                AutomationProperties.HelpText="Indicates whether the asset catalog is loading."
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            AutomationProperties.LandmarkType="Navigation"
            XYFocusKeyboardNavigation="Enabled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{StaticResource ShellBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Base Disks" />
                    <TextBlock
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.BaseDisksSummaryText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Left"
                        TabIndex="0"
                        AccessKey="B"
                        AutomationProperties.Name="Open Base Disks"
                        AutomationProperties.HelpText="Open the base disk asset management view."
                        Command="{x:Bind ViewModel.OpenBaseDisksCommand}"
                        Content="Open Base Disks" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="12"
                Background="{StaticResource ShellBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Switches" />
                    <TextBlock
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.SwitchesSummaryText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Left"
                        TabIndex="1"
                        AccessKey="S"
                        AutomationProperties.Name="Open Switches"
                        AutomationProperties.HelpText="Open the virtual switch asset management view."
                        Command="{x:Bind ViewModel.OpenSwitchesCommand}"
                        Content="Open Switches" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
