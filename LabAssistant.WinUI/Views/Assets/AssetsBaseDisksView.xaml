<UserControl
    x:Class="LabAssistant.WinUI.Views.Assets.AssetsBaseDisksView"
    x:Name="AssetsBaseDisksViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LabAssistant.WinUI.ViewModels.Assets">
    <Grid
        RowSpacing="12"
        AutomationProperties.LandmarkType="Main"
        XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="10"
            Background="{StaticResource ShellContentBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            AutomationProperties.LandmarkType="Custom"
            AutomationProperties.LocalizedLandmarkType="Base disk status">
            <TextBlock
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Border>

        <Grid
            Grid.Row="1"
            ColumnSpacing="12"
            XYFocusKeyboardNavigation="Enabled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                AutomationProperties.LandmarkType="Navigation">
                <Grid RowSpacing="8" XYFocusKeyboardNavigation="Enabled">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Registered Base Disks" />
                        <Button
                            TabIndex="0"
                            AccessKey="R"
                            AutomationProperties.Name="Refresh base disks"
                            AutomationProperties.HelpText="Reload the registered base disk catalog."
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                            Content="Refresh" />
                        <Button
                            TabIndex="1"
                            AccessKey="I"
                            AutomationProperties.Name="Import disk"
                            AutomationProperties.HelpText="Import a base disk into the catalog."
                            Command="{x:Bind ViewModel.AddDiskCommand}"
                            IsEnabled="{x:Bind ViewModel.CanAddDisk, Mode=OneWay}"
                            Content="Import Disk" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        TabIndex="2"
                        AutomationProperties.Name="Registered base disks list"
                        AutomationProperties.HelpText="Browse and select a registered base disk to review or edit its details."
                        ItemsSource="{x:Bind ViewModel.BaseDisks, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDisk, Mode=TwoWay}"
                        SelectionMode="Single"
                        XYFocusKeyboardNavigation="Enabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BaseDiskListItem">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DisplayName}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind Path}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind SizeDisplay}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                AutomationProperties.LandmarkType="Form">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Selected Disk Details" />
                            <Button
                                TabIndex="3"
                                AccessKey="V"
                                AutomationProperties.Name="Validate base disk"
                                AutomationProperties.HelpText="Validate the selected base disk metadata and readiness."
                                Command="{x:Bind ViewModel.ValidateCommand}"
                                IsEnabled="{x:Bind ViewModel.CanValidate, Mode=OneWay}"
                                Content="Validate" />
                            <Button
                                TabIndex="4"
                                AccessKey="S"
                                AutomationProperties.Name="Save base disk metadata"
                                AutomationProperties.HelpText="Save metadata changes for the selected base disk."
                                Command="{x:Bind ViewModel.SaveMetadataCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSaveMetadata, Mode=OneWay}"
                                Content="Save Metadata" />
                            <Button
                                TabIndex="5"
                                AccessKey="M"
                                AutomationProperties.Name="Remove base disk from catalog"
                                AutomationProperties.HelpText="Remove the selected base disk from the catalog."
                                Command="{x:Bind ViewModel.RemoveDiskCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                                Content="Remove from Catalog" />
                        </StackPanel>

                        <TextBlock
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.SelectedDiskSummaryText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <StackPanel Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}" Spacing="8">
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                AutomationProperties.LiveSetting="Polite"
                                Text="{x:Bind ViewModel.SelectedDiskValidationText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource ShellWarnBrush}"
                                AutomationProperties.LiveSetting="Assertive"
                                Text="{x:Bind ViewModel.ReferenceWarningText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="8" RowSpacing="8" XYFocusKeyboardNavigation="Enabled">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="OsNameLabel" Grid.Row="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="OS name" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                TabIndex="6"
                                AutomationProperties.Name="Operating system name"
                                AutomationProperties.HelpText="Edit the operating system name for the selected base disk."
                                AutomationProperties.LabeledBy="{Binding ElementName=OsNameLabel}"
                                Text="{x:Bind ViewModel.OsName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock x:Name="OsVersionLabel" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="OS version" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                TabIndex="7"
                                AutomationProperties.Name="Operating system version"
                                AutomationProperties.HelpText="Edit the operating system version for the selected base disk."
                                AutomationProperties.LabeledBy="{Binding ElementName=OsVersionLabel}"
                                Text="{x:Bind ViewModel.OsVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock x:Name="DiskPathLabel" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Path" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8" XYFocusKeyboardNavigation="Enabled">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    TabIndex="8"
                                    AutomationProperties.Name="Base disk path"
                                    AutomationProperties.HelpText="Shows the filesystem path for the selected base disk."
                                    AutomationProperties.LabeledBy="{Binding ElementName=DiskPathLabel}"
                                    IsReadOnly="True"
                                    Text="{x:Bind ViewModel.DiskPath, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    TabIndex="9"
                                    AccessKey="B"
                                    AutomationProperties.Name="Browse base disk path"
                                    AutomationProperties.HelpText="Open the folder that contains the selected base disk."
                                    Command="{x:Bind ViewModel.BrowsePathCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanBrowsePath, Mode=OneWay}"
                                    Content="Browse" />
                            </Grid>

                            <TextBlock x:Name="GenerationLabel" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Generation" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                TabIndex="10"
                                AutomationProperties.Name="Virtual machine generation"
                                AutomationProperties.HelpText="Edit the Hyper-V generation recorded for the selected base disk."
                                AutomationProperties.LabeledBy="{Binding ElementName=GenerationLabel}"
                                Text="{x:Bind ViewModel.GenerationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock x:Name="NotesLabel" Grid.Row="4" VerticalAlignment="Top" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Notes" />
                            <TextBox
                                Grid.Row="4"
                                Grid.Column="1"
                                TabIndex="11"
                                AcceptsReturn="True"
                                MinHeight="72"
                                AutomationProperties.Name="Base disk notes"
                                AutomationProperties.HelpText="Edit notes for the selected base disk."
                                AutomationProperties.LabeledBy="{Binding ElementName=NotesLabel}"
                                TextWrapping="Wrap"
                                Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid
            Grid.Row="2"
            ColumnSpacing="12"
            XYFocusKeyboardNavigation="Enabled">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                AutomationProperties.LandmarkType="Custom"
                AutomationProperties.LocalizedLandmarkType="Loading status">
                <StackPanel Spacing="6">
                    <ProgressRing
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Loading base disk details"
                        AutomationProperties.HelpText="Indicates that base disk information is loading."
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.LoadingStateText, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                AutomationProperties.LandmarkType="Custom"
                AutomationProperties.LocalizedLandmarkType="Empty state">
                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>

            <Border
                Grid.Column="2"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                AutomationProperties.LandmarkType="Custom"
                AutomationProperties.LocalizedLandmarkType="Error status">
                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" AutomationProperties.LiveSetting="Assertive" Text="{x:Bind ViewModel.ErrorStateText, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
