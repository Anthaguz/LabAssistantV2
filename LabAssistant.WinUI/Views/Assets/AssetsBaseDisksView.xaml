<UserControl
    x:Class="LabAssistant.WinUI.Views.Assets.AssetsBaseDisksView"
    x:Name="AssetsBaseDisksViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LabAssistant.WinUI.ViewModels.Assets">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="10"
            Background="{StaticResource ShellContentBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <TextBlock
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </Border>

        <Grid
            Grid.Row="1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Registered Base Disks" />
                        <Button
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                            Content="Refresh" />
                        <Button
                            Command="{x:Bind ViewModel.AddDiskCommand}"
                            IsEnabled="{x:Bind ViewModel.CanAddDisk, Mode=OneWay}"
                            Content="Import Disk" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.BaseDisks, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedDisk, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:BaseDiskListItem">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DisplayName}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind Path}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind SizeDisplay}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Selected Disk Details" />
                            <Button
                                Command="{x:Bind ViewModel.ValidateCommand}"
                                IsEnabled="{x:Bind ViewModel.CanValidate, Mode=OneWay}"
                                Content="Validate" />
                            <Button
                                Command="{x:Bind ViewModel.SaveMetadataCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSaveMetadata, Mode=OneWay}"
                                Content="Save Metadata" />
                            <Button
                                Command="{x:Bind ViewModel.RemoveDiskCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                                Content="Remove from Catalog" />
                        </StackPanel>

                        <TextBlock
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.SelectedDiskSummaryText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <StackPanel Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}" Spacing="8">
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.SelectedDiskValidationText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{StaticResource ShellWarnBrush}"
                                Text="{x:Bind ViewModel.ReferenceWarningText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="OS name" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.OsName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="OS version" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OsVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Path" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" IsReadOnly="True" Text="{x:Bind ViewModel.DiskPath, Mode=OneWay}" />
                                <Button
                                    Grid.Column="1"
                                    Command="{x:Bind ViewModel.BrowsePathCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanBrowsePath, Mode=OneWay}"
                                    Content="Browse" />
                            </Grid>

                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Generation" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.GenerationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" VerticalAlignment="Top" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Notes" />
                            <TextBox Grid.Row="4" Grid.Column="1" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid
            Grid.Row="2"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.LoadingStateText, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>

            <Border
                Grid.Column="2"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.ErrorStateText, Mode=OneWay}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
