<UserControl
    x:Class="LabAssistant.WinUI.Views.Assets.AssetsBaseDisksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="AssetsBaseDisksActionsRegion"
                Grid.Row="0"
                Visibility="Collapsed"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="Action placement moved into inventory and details headers."
                    TextWrapping="Wrap" />
            </Border>

            <Border
                x:Name="AssetsBaseDisksStatusRegion"
                Grid.Row="1"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Status / Feedback" />
                    <TextBlock
                        x:Name="AssetsBaseDisksStatusTextBlock"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Base disk status, validation, and recovery guidance appear here."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid
                x:Name="AssetsBaseDisksWorkspaceGrid"
                Grid.Row="2"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="AssetsBaseDisksListRegion"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Registered Base Disks" />
                            <Button
                                x:Name="AssetsBaseDisksRefreshButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="0,0,8,0"
                                ToolTipService.ToolTip="Refresh base disk inventory">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                x:Name="AssetsBaseDisksImportButton"
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                ToolTipService.ToolTip="Import or register base disk">
                                <FontIcon Glyph="&#xE710;" />
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="AssetsBaseDisksListView"
                            Grid.Row="1"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding SecondaryText}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding ValidationSummary}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="AssetsBaseDisksDetailsRegion"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                    FontWeight="SemiBold"
                                    Text="Selected Disk Details" />
                                <Button
                                    x:Name="AssetsBaseDisksValidateButton"
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    ToolTipService.ToolTip="Validate selected base disk">
                                    <FontIcon Glyph="&#xE73E;" />
                                </Button>
                                <Button
                                    x:Name="AssetsBaseDisksSaveMetadataButton"
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    ToolTipService.ToolTip="Save base disk metadata">
                                    <FontIcon Glyph="&#xE74E;" />
                                </Button>
                                <Button
                                    x:Name="AssetsBaseDisksRemoveButton"
                                    Grid.Column="3"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    ToolTipService.ToolTip="Remove base disk from catalog">
                                    <FontIcon Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                x:Name="AssetsBaseDisksSelectedDiskSummaryTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Select a base disk to inspect metadata, validation state, and registry-only removal warnings."
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AssetsBaseDisksSelectedDiskValidationTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Validation has not been evaluated."
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AssetsBaseDisksReferenceWarningTextBlock"
                                Foreground="{StaticResource ShellWarnBrush}"
                                Text="No removal assessment has been performed."
                                TextWrapping="Wrap" />

                            <Border
                                x:Name="AssetsBaseDisksMetadataEditRegion"
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="OS name" />
                                    <TextBox
                                        x:Name="AssetsBaseDisksOsNameTextBox"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        PlaceholderText="Windows Server" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="OS version" />
                                    <TextBox
                                        x:Name="AssetsBaseDisksOsVersionTextBox"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        PlaceholderText="2022" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Path" />
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="AssetsBaseDisksPathTextBox"
                                            Grid.Column="0"
                                            IsReadOnly="True"
                                            PlaceholderText="Select a VHDX path to register or edit." />
                                        <Button
                                            x:Name="AssetsBaseDisksBrowsePathButton"
                                            Grid.Column="1"
                                            Content="Browse" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Generation" />
                                    <TextBox
                                        x:Name="AssetsBaseDisksGenerationTextBox"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        PlaceholderText="1 or 2" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Grid.Column="0"
                                        VerticalAlignment="Top"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Notes" />
                                    <TextBox
                                        x:Name="AssetsBaseDisksNotesTextBox"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        AcceptsReturn="True"
                                        MinHeight="72"
                                        TextWrapping="Wrap"
                                        PlaceholderText="Optional notes" />
                                    <TextBlock
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Right"
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        FontSize="12"
                                        Text="Use the header actions to validate, save metadata, or remove this base disk. Registry-only removal."
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid
                    x:Name="AssetsBaseDisksStateRegion"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AssetsBaseDisksLoadingStatePanel"
                        Grid.Column="0"
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Loading State" />
                            <TextBlock
                                x:Name="AssetsBaseDisksLoadingStateTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Catalog loading and refresh progress appears here."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AssetsBaseDisksEmptyStatePanel"
                        Grid.Column="1"
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Empty State" />
                            <TextBlock
                                x:Name="AssetsBaseDisksEmptyStateTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="No base disks are registered yet. Import a VHDX, review the metadata, then save it to register the disk."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AssetsBaseDisksErrorStatePanel"
                        Grid.Column="2"
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellCriticalBrush}"
                                FontWeight="SemiBold"
                                Text="Error State" />
                            <TextBlock
                                x:Name="AssetsBaseDisksErrorStateTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Actionable load, save, validate, or remove failures appear here."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
