<UserControl
    x:Class="LabAssistant.WinUI.Views.Assets.AssetsSwitchesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="AssetsSwitchesWorkspaceGrid"
                Grid.Row="0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="AssetsSwitchesListColumnDefinition" Width="1.15*" />
                    <ColumnDefinition x:Name="AssetsSwitchesDetailsColumnDefinition" Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="AssetsSwitchesPrimaryRowDefinition" Height="*" />
                    <RowDefinition x:Name="AssetsSwitchesStateRowDefinition" Height="Auto" />
                    <RowDefinition x:Name="AssetsSwitchesDetailsRowDefinition" Height="0" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="AssetsSwitchesListRegion"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Virtual Switch Inventory" />
                            <Button
                                x:Name="AssetsSwitchesRefreshButton"
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                IsEnabled="{Binding CanRefresh, Mode=OneWay}"
                                ToolTipService.ToolTip="Refresh switch inventory">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                        <ListView
                            x:Name="AssetsSwitchesListView"
                            Grid.Row="1"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding SecondaryText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="AssetsSwitchesDetailsRegion"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                    FontWeight="SemiBold"
                                    Text="Selected Switch Details" />
                                <Button
                                    x:Name="AssetsSwitchesCreateButton"
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanCreate, Mode=OneWay}"
                                    ToolTipService.ToolTip="Create a new virtual switch">
                                    <FontIcon Glyph="&#xE710;" />
                                </Button>
                                <Button
                                    x:Name="AssetsSwitchesApplyButton"
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanApply, Mode=OneWay}"
                                    ToolTipService.ToolTip="Apply switch changes">
                                    <FontIcon Glyph="&#xE74E;" />
                                </Button>
                                <Button
                                    x:Name="AssetsSwitchesDeleteButton"
                                    Grid.Column="3"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    IsEnabled="{Binding CanDelete, Mode=OneWay}"
                                    ToolTipService.ToolTip="Delete virtual switch">
                                    <FontIcon Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                x:Name="AssetsSwitchesStatusTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{Binding StatusText, Mode=OneWay}"
                                Visibility="{Binding StatusVisibility, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AssetsSwitchesSelectedSwitchValidationTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{Binding SelectedSwitchValidationText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AssetsSwitchesDeleteConstraintTextBlock"
                                Foreground="{StaticResource ShellWarnBrush}"
                                Text="{Binding DeleteConstraintText, Mode=OneWay}"
                                Visibility="{Binding DeleteConstraintVisibility, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <Border
                                x:Name="AssetsSwitchesEditRegion"
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Switch name" />
                                    <TextBox
                                        x:Name="AssetsSwitchesNameTextBox"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        PlaceholderText="Lab External" />
                                    <Grid
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            Text="Switch type" />
                                        <TextBlock
                                            x:Name="AssetsSwitchesTypeInfoButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Text="&#xE946;"
                                            ToolTipService.ToolTip="External: binds the switch to a host network adapter for outside connectivity.&#x0a;Internal: creates host-to-VM networking only; no direct external adapter binding.&#x0a;Private: allows networking only between VMs attached to the same switch." />
                                    </Grid>
                                    <ComboBox
                                        x:Name="AssetsSwitchesTypeComboBox"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        IsEnabled="{Binding CanEditSwitchType, Mode=OneWay}"
                                        PlaceholderText="Select type">
                                        <ComboBoxItem Content="External" />
                                        <ComboBoxItem Content="Internal" />
                                        <ComboBoxItem Content="Private" />
                                    </ComboBox>
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Adapter / target" />
                                    <TextBox
                                        x:Name="AssetsSwitchesAdapterTextBox"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        IsEnabled="{Binding CanEditAdapter, Mode=OneWay}"
                                        PlaceholderText="Physical adapter or target guidance appears here." />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        VerticalAlignment="Top"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Attached VMs" />
                                    <StackPanel
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Spacing="6">
                                        <TextBlock
                                            x:Name="AssetsSwitchesAttachedVmsHintTextBlock"
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding AttachedVmHintText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <ListView
                                            x:Name="AssetsSwitchesAttachedVmsListView"
                                            MaxHeight="120"
                                            MinHeight="72"
                                            IsItemClickEnabled="False"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            SelectionMode="None" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid
                    x:Name="AssetsSwitchesStateRegion"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AssetsSwitchesLoadingStatePanel"
                        Grid.Column="0"
                        Padding="10"
                        Visibility="{Binding LoadingStateVisibility, Mode=OneWay}"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Loading State" />
                            <TextBlock
                                x:Name="AssetsSwitchesLoadingStateTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{Binding LoadingStateText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AssetsSwitchesEmptyStatePanel"
                        Grid.Column="1"
                        Padding="10"
                        Visibility="{Binding EmptyStateVisibility, Mode=OneWay}"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Empty State" />
                            <TextBlock
                                x:Name="AssetsSwitchesEmptyStateTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="{Binding EmptyStateText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AssetsSwitchesErrorStatePanel"
                        Grid.Column="2"
                        Padding="10"
                        Visibility="{Binding ErrorStateVisibility, Mode=OneWay}"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Error State" />
                            <TextBox
                                x:Name="AssetsSwitchesErrorStateTextBox"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                MinHeight="72"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Text="{Binding ErrorStateText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
