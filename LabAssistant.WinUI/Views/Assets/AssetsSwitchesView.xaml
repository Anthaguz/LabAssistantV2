<UserControl
    x:Class="LabAssistant.WinUI.Views.Assets.AssetsSwitchesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Foreground="{StaticResource ShellTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Assets / Virtual Switches" />

            <TextBlock
                Grid.Row="1"
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="Manage Hyper-V virtual switches with in-context create/edit flow, explicit validation signals, and guarded delete semantics."
                TextWrapping="Wrap" />

            <Border
                x:Name="AssetsSwitchesActionsRegion"
                Grid.Row="2"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="AssetsSwitchesRefreshButton"
                        Grid.Column="0"
                        Content="Refresh" />
                    <Button
                        x:Name="AssetsSwitchesCreateButton"
                        Grid.Column="1"
                        Content="Create" />
                    <Button
                        x:Name="AssetsSwitchesApplyButton"
                        Grid.Column="2"
                        Content="Apply" />
                    <Button
                        x:Name="AssetsSwitchesValidateButton"
                        Grid.Column="3"
                        Content="Validate" />
                    <Button
                        x:Name="AssetsSwitchesDeleteButton"
                        Grid.Column="4"
                        Content="Delete" />
                    <TextBlock
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Scaffold only. Delete guardrails and Hyper-V wiring arrive in AK3."
                        TextAlignment="Right"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border
                x:Name="AssetsSwitchesStatusRegion"
                Grid.Row="3"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Status / Feedback" />
                    <TextBlock
                        x:Name="AssetsSwitchesStatusTextBlock"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Switch loading, validation, and delete guidance will appear here when AK3 wiring is added."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid
                x:Name="AssetsSwitchesWorkspaceGrid"
                Grid.Row="4"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="AssetsSwitchesListRegion"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Virtual Switch Inventory" />
                        <ListView
                            x:Name="AssetsSwitchesListView"
                            Grid.Row="1"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding SecondaryText}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding ValidationSummary}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    x:Name="AssetsSwitchesDetailsRegion"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="10"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Selected Switch Details" />
                            <TextBlock
                                x:Name="AssetsSwitchesSelectedSwitchSummaryTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Select a switch to review configuration, validation state, and delete constraints."
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AssetsSwitchesSelectedSwitchValidationTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Validation has not been evaluated."
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="AssetsSwitchesDeleteConstraintTextBlock"
                                Foreground="{StaticResource ShellWarnBrush}"
                                Text="Delete guardrails are scaffold-only in AK2."
                                TextWrapping="Wrap" />

                            <Border
                                x:Name="AssetsSwitchesEditRegion"
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Switch name" />
                                    <TextBox
                                        x:Name="AssetsSwitchesNameTextBox"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        PlaceholderText="Lab External" />
                                    <Grid
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            Text="Switch type" />
                                        <TextBlock
                                            x:Name="AssetsSwitchesTypeInfoButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Text="&#xE946;"
                                            ToolTipService.ToolTip="External: binds the switch to a host network adapter for outside connectivity.&#x0a;Internal: creates host-to-VM networking only; no direct external adapter binding.&#x0a;Private: allows networking only between VMs attached to the same switch." />
                                    </Grid>
                                    <ComboBox
                                        x:Name="AssetsSwitchesTypeComboBox"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        PlaceholderText="Select type">
                                        <ComboBoxItem Content="External" />
                                        <ComboBoxItem Content="Internal" />
                                        <ComboBoxItem Content="Private" />
                                    </ComboBox>
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Adapter / target" />
                                    <TextBox
                                        x:Name="AssetsSwitchesAdapterTextBox"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        PlaceholderText="Physical adapter or target guidance appears here." />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        VerticalAlignment="Top"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="Attached VMs" />
                                    <TextBox
                                        x:Name="AssetsSwitchesAttachedVmsTextBox"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        AcceptsReturn="True"
                                        IsReadOnly="True"
                                        MinHeight="72"
                                        TextWrapping="Wrap"
                                        PlaceholderText="Attached VM names and delete guidance appear here." />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid
                    x:Name="AssetsSwitchesStateRegion"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AssetsSwitchesLoadingStatePanel"
                        Grid.Column="0"
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Loading State" />
                            <TextBlock
                                x:Name="AssetsSwitchesLoadingStateTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Switch inventory loading guidance appears here." />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AssetsSwitchesEmptyStatePanel"
                        Grid.Column="1"
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Empty State" />
                            <TextBlock
                                x:Name="AssetsSwitchesEmptyStateTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="No switches loaded yet. AK3 will populate inventory and create flow." />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AssetsSwitchesErrorStatePanel"
                        Grid.Column="2"
                        Padding="10"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Error State" />
                            <TextBlock
                                x:Name="AssetsSwitchesErrorStateTextBlock"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Switch load and validation failures will surface here with actionable recovery text." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
