<UserControl
    x:Class="LabAssistant.WinUI.Views.Assets.AssetsSwitchesView"
    x:Name="AssetsSwitchesViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LabAssistant.WinUI.ViewModels.Assets">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Virtual Switch Inventory" />
                        <Button
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                            Content="Refresh" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Switches, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedSwitch, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:SwitchListItem">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind DisplayName}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind SecondaryText}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{x:Bind Status}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontWeight="SemiBold"
                                Text="Selected Switch Details" />
                            <Button
                                Command="{x:Bind ViewModel.CreateSwitchCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCreateSwitch, Mode=OneWay}"
                                Content="New Switch" />
                            <Button
                                Command="{x:Bind ViewModel.SaveChangesCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSaveChanges, Mode=OneWay}"
                                Content="Save Changes" />
                            <Button
                                Command="{x:Bind ViewModel.DeleteSwitchCommand}"
                                IsEnabled="{x:Bind ViewModel.CanDeleteSwitch, Mode=OneWay}"
                                Content="Delete Switch" />
                        </StackPanel>

                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedSwitchValidationText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock
                            Visibility="{x:Bind ViewModel.DeleteConstraintVisibility, Mode=OneWay}"
                            Foreground="{StaticResource ShellWarnBrush}"
                            Text="{x:Bind ViewModel.DeleteConstraintText, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Switch name" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SwitchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Switch type" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.SwitchTypes, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanEditSwitchType, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Adapter / target" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                IsEnabled="{x:Bind ViewModel.CanEditAdapter, Mode=OneWay}"
                                Text="{x:Bind ViewModel.AdapterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" VerticalAlignment="Top" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Attached VMs" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.AttachedVmHintText, Mode=OneWay}" TextWrapping="Wrap" />
                                <ListView ItemsSource="{x:Bind ViewModel.AttachedVmNames, Mode=OneWay}" MinHeight="72" MaxHeight="120" SelectionMode="None" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.LoadingStateText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" />
            </Border>

            <Border
                Grid.Column="2"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}"
                Padding="10"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellCriticalBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBox
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="{x:Bind ViewModel.ErrorStateText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
