<UserControl
    x:Class="LabAssistant.WinUI.Views.Diagnostics.DiagnosticsLogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="DiagnosticsLogsPanel"
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="8">
                <TextBlock
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Structured Logs" />
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="LogFilterOperationIdTextBox" Grid.Row="0" Grid.Column="0" Width="180" PlaceholderText="OperationId" />
                        <TextBox x:Name="LogFilterLevelTextBox" Grid.Row="0" Grid.Column="1" Width="120" PlaceholderText="Level" />
                        <TextBox x:Name="LogFilterEventTextBox" Grid.Row="0" Grid.Column="2" Width="180" PlaceholderText="Event" />
                        <TextBox x:Name="LogFilterTextSearchTextBox" Grid.Row="0" Grid.Column="3" Width="220" PlaceholderText="Text search" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <CheckBox x:Name="LogFilterUseStartDateCheckBox" VerticalAlignment="Center" Content="Start" />
                            <DatePicker x:Name="LogFilterStartDatePicker" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <CheckBox x:Name="LogFilterUseEndDateCheckBox" VerticalAlignment="Center" Content="End" />
                            <DatePicker x:Name="LogFilterEndDatePicker" />
                        </StackPanel>
                        <Button x:Name="ApplyLogFiltersButton" Grid.Row="1" Grid.Column="2" Content="Apply filters" />
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ClearLogFiltersButton" Content="Clear filters" />
                            <Button x:Name="ReloadLogsButton" Content="Reload" />
                            <Button x:Name="OpenRawJsonlButton" Content="Open raw JSONL" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <TextBlock
                    x:Name="LogsStatusTextBlock"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="Logs not loaded yet."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListView
                x:Name="StructuredLogsListView"
                Grid.Row="1"
                Grid.Column="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{Binding TimestampText}" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Level}" />
                            <TextBlock Grid.Column="2" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Event}" />
                            <TextBlock Grid.Column="3" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding OperationId}" />
                            <TextBlock Grid.Column="4" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Result}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="8"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Selected Context" />
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="88"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="SelectedLogEnvelopeTextBlock"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            Text="Select a log entry."
                            TextWrapping="WrapWholeWords" />
                    </ScrollViewer>
                    <TextBox
                        x:Name="SelectedLogContextTextBox"
                        Grid.Row="2"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Stretch"
                        FontFamily="Consolas"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
