<UserControl
    x:Class="LabAssistant.WinUI.Views.Diagnostics.DiagnosticsLogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:logging="using:LabAssistant.Services.Logging">
    <Border
        Padding="{StaticResource CardPadding}"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardCornerRadius}"
        AutomationProperties.LandmarkType="Main">
        <Grid ColumnSpacing="12" XYFocusKeyboardNavigation="Enabled">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="{StaticResource SpacingS}" AutomationProperties.LandmarkType="Form">
                <TextBlock
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Structured Logs" />
                <StackPanel Spacing="{StaticResource SpacingS}">
                    <Grid ColumnSpacing="{StaticResource SpacingS}" RowSpacing="{StaticResource SpacingS}" XYFocusKeyboardNavigation="Enabled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Width="180" TabIndex="0" AutomationProperties.Name="Filter by operation ID" AutomationProperties.HelpText="Filter logs by operation identifier." PlaceholderText="OperationId" Text="{x:Bind ViewModel.OperationIdQuery, Mode=TwoWay}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Width="120" TabIndex="1" AutomationProperties.Name="Filter by log level" AutomationProperties.HelpText="Filter logs by severity level." PlaceholderText="Level" Text="{x:Bind ViewModel.LevelQuery, Mode=TwoWay}" />
                        <TextBox Grid.Row="0" Grid.Column="2" Width="180" TabIndex="2" AutomationProperties.Name="Filter by event" AutomationProperties.HelpText="Filter logs by event name." PlaceholderText="Event" Text="{x:Bind ViewModel.EventQuery, Mode=TwoWay}" />
                        <TextBox Grid.Row="0" Grid.Column="3" Width="220" TabIndex="3" AutomationProperties.Name="Filter by text search" AutomationProperties.HelpText="Filter logs by free-text search." PlaceholderText="Text search" Text="{x:Bind ViewModel.TextSearchQuery, Mode=TwoWay}" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <CheckBox VerticalAlignment="Center" TabIndex="4" AutomationProperties.Name="Enable start date filter" AutomationProperties.HelpText="Turn on filtering from a start date." Content="Start" IsChecked="{x:Bind ViewModel.UseStartDateFilter, Mode=TwoWay}" />
                            <DatePicker TabIndex="5" AutomationProperties.Name="Start date" AutomationProperties.HelpText="Choose the start date for log filtering." Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <CheckBox VerticalAlignment="Center" TabIndex="6" AutomationProperties.Name="Enable end date filter" AutomationProperties.HelpText="Turn on filtering to an end date." Content="End" IsChecked="{x:Bind ViewModel.UseEndDateFilter, Mode=TwoWay}" />
                            <DatePicker TabIndex="7" AutomationProperties.Name="End date" AutomationProperties.HelpText="Choose the end date for log filtering." Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" />
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="2" TabIndex="8" AccessKey="A" AutomationProperties.Name="Apply log filters" AutomationProperties.HelpText="Apply the current log filters." Content="Apply filters" Command="{x:Bind ViewModel.ApplyFiltersCommand}" />
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                            <Button TabIndex="9" AccessKey="C" AutomationProperties.Name="Clear log filters" AutomationProperties.HelpText="Clear all log filters." Content="Clear filters" Command="{x:Bind ViewModel.ClearFiltersCommand}" />
                            <Button TabIndex="10" AccessKey="R" AutomationProperties.Name="Reload logs" AutomationProperties.HelpText="Reload the structured logs list." Content="Reload" Command="{x:Bind ViewModel.ReloadCommand}" />
                            <Button TabIndex="11" AccessKey="J" AutomationProperties.Name="Open raw JSONL log file" AutomationProperties.HelpText="Open the raw JSONL log file." Content="Open raw JSONL" Command="{x:Bind ViewModel.OpenRawJsonlCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <TextBlock
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListView
                Grid.Row="1"
                Grid.Column="0"
                TabIndex="12"
                AutomationProperties.Name="Structured logs list"
                AutomationProperties.HelpText="Browse structured log entries and select one to review its context."
                ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedEntry, Mode=TwoWay}"
                XYFocusKeyboardNavigation="Enabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="logging:StructuredLogViewerEntry">
                        <Grid Padding="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{x:Bind TimestampText}" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind Level}" />
                            <TextBlock Grid.Column="2" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind Event}" />
                            <TextBlock Grid.Column="3" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind OperationId}" />
                            <TextBlock Grid.Column="4" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind Result}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="8"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}"
                AutomationProperties.LandmarkType="Form">
                <Grid RowSpacing="{StaticResource SpacingS}" XYFocusKeyboardNavigation="Enabled">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Selected Context" />
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="88"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            Text="{x:Bind ViewModel.SelectedEnvelopeText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </ScrollViewer>
                    <TextBox
                        Grid.Row="2"
                        TabIndex="13"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Selected log context"
                        AutomationProperties.HelpText="Read the detailed context for the selected log entry."
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Stretch"
                        FontFamily="Consolas"
                        Text="{x:Bind ViewModel.SelectedContextText, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
