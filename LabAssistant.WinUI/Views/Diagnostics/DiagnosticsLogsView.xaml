<UserControl
    x:Class="LabAssistant.WinUI.Views.Diagnostics.DiagnosticsLogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="DiagnosticsLogsPanel"
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        AutomationProperties.LandmarkType="Main">
        <Grid ColumnSpacing="12" XYFocusKeyboardNavigation="Enabled">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="8" AutomationProperties.LandmarkType="Form">
                <TextBlock
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Structured Logs" />
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8" RowSpacing="8" XYFocusKeyboardNavigation="Enabled">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="LogFilterOperationIdTextBox" Grid.Row="0" Grid.Column="0" Width="180" TabIndex="0" AutomationProperties.Name="Filter by operation ID" AutomationProperties.HelpText="Filter logs by operation identifier." PlaceholderText="OperationId" />
                        <TextBox x:Name="LogFilterLevelTextBox" Grid.Row="0" Grid.Column="1" Width="120" TabIndex="1" AutomationProperties.Name="Filter by log level" AutomationProperties.HelpText="Filter logs by severity level." PlaceholderText="Level" />
                        <TextBox x:Name="LogFilterEventTextBox" Grid.Row="0" Grid.Column="2" Width="180" TabIndex="2" AutomationProperties.Name="Filter by event" AutomationProperties.HelpText="Filter logs by event name." PlaceholderText="Event" />
                        <TextBox x:Name="LogFilterTextSearchTextBox" Grid.Row="0" Grid.Column="3" Width="220" TabIndex="3" AutomationProperties.Name="Filter by text search" AutomationProperties.HelpText="Filter logs by free-text search." PlaceholderText="Text search" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <CheckBox x:Name="LogFilterUseStartDateCheckBox" VerticalAlignment="Center" TabIndex="4" AutomationProperties.Name="Enable start date filter" AutomationProperties.HelpText="Turn on filtering from a start date." Content="Start" />
                            <DatePicker x:Name="LogFilterStartDatePicker" TabIndex="5" AutomationProperties.Name="Start date" AutomationProperties.HelpText="Choose the start date for log filtering." />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <CheckBox x:Name="LogFilterUseEndDateCheckBox" VerticalAlignment="Center" TabIndex="6" AutomationProperties.Name="Enable end date filter" AutomationProperties.HelpText="Turn on filtering to an end date." Content="End" />
                            <DatePicker x:Name="LogFilterEndDatePicker" TabIndex="7" AutomationProperties.Name="End date" AutomationProperties.HelpText="Choose the end date for log filtering." />
                        </StackPanel>
                        <Button x:Name="ApplyLogFiltersButton" Grid.Row="1" Grid.Column="2" TabIndex="8" AccessKey="A" AutomationProperties.Name="Apply log filters" AutomationProperties.HelpText="Apply the current log filters." Content="Apply filters" />
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ClearLogFiltersButton" TabIndex="9" AccessKey="C" AutomationProperties.Name="Clear log filters" AutomationProperties.HelpText="Clear all log filters." Content="Clear filters" />
                            <Button x:Name="ReloadLogsButton" TabIndex="10" AccessKey="R" AutomationProperties.Name="Reload logs" AutomationProperties.HelpText="Reload the structured logs list." Content="Reload" />
                            <Button x:Name="OpenRawJsonlButton" TabIndex="11" AccessKey="J" AutomationProperties.Name="Open raw JSONL log file" AutomationProperties.HelpText="Open the raw JSONL log file." Content="Open raw JSONL" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <TextBlock
                    x:Name="LogsStatusTextBlock"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    AutomationProperties.LiveSetting="Polite"
                    Text="Logs not loaded yet."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListView
                x:Name="StructuredLogsListView"
                Grid.Row="1"
                Grid.Column="0"
                TabIndex="12"
                AutomationProperties.Name="Structured logs list"
                AutomationProperties.HelpText="Browse structured log entries and select one to review its context."
                XYFocusKeyboardNavigation="Enabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{Binding TimestampText}" />
                            <TextBlock Grid.Column="1" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Level}" />
                            <TextBlock Grid.Column="2" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Event}" />
                            <TextBlock Grid.Column="3" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding OperationId}" />
                            <TextBlock Grid.Column="4" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Result}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="8"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                AutomationProperties.LandmarkType="Form">
                <Grid RowSpacing="8" XYFocusKeyboardNavigation="Enabled">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontWeight="SemiBold"
                        Text="Selected Context" />
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="88"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="SelectedLogEnvelopeTextBlock"
                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite"
                            Text="Select a log entry."
                            TextWrapping="WrapWholeWords" />
                    </ScrollViewer>
                    <TextBox
                        x:Name="SelectedLogContextTextBox"
                        Grid.Row="2"
                        TabIndex="13"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Selected log context"
                        AutomationProperties.HelpText="Read the detailed context for the selected log entry."
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Stretch"
                        FontFamily="Consolas"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
