<UserControl
    x:Class="LabAssistant.WinUI.Views.Templates.TemplatesBuilderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        VerticalAlignment="Stretch">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="V2 Template Builder" />
                <TextBlock
                    x:Name="BuilderContextTextBlock"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="No Builder draft loaded."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="BuilderReferenceTextBlock"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="No reference data loaded."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid
                Grid.Row="1"
                x:Name="BuilderStepWorkflowGrid"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="BuilderLeftStepper"
                    Grid.Column="0"
                    Padding="8"
                    Background="{StaticResource ShellContentBackgroundBrush}"
                    BorderBrush="{StaticResource ShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel x:Name="BuilderWorkflowTreePanel" Spacing="6">
                        <StackPanel x:Name="BuilderVmNavChildrenPanel" Margin="14,0,0,0" Spacing="4" />
                    </StackPanel>
                </Border>

                <ScrollViewer
                    x:Name="BuilderActiveStepScrollViewer"
                    Grid.Column="1"
                    VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="BuilderActiveStepPanel" Margin="0,0,10,0">
                        <Border
                            x:Name="BuilderGeneralSection"
                            Padding="8"
                            Background="{StaticResource ShellContentBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="General" />
                                    <TextBox x:Name="BuilderTemplateNameTextBox" Header="Template Name" PlaceholderText="Template name" />
                                    <TextBox
                                        x:Name="BuilderTemplateDescriptionTextBox"
                                        Header="Description"
                                        AcceptsReturn="True"
                                        MinHeight="56"
                                        MaxHeight="96"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Deployment Profile" />
                                    <ComboBox x:Name="BuilderDeploymentProfileComboBox">
                                        <ComboBoxItem Content="Conservative" />
                                        <ComboBoxItem Content="Balanced" />
                                        <ComboBoxItem Content="Aggressive" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="BuilderNetworksSection"
                            Padding="8"
                            Background="{StaticResource ShellContentBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Networks" />
                                    <Button x:Name="BuilderAddNetworkButton" Content="Add Network" />
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" x:Name="BuilderNetworksListPanel" Spacing="6" />
                                    <StackPanel Grid.Column="1" x:Name="BuilderSelectedNetworkDetailPanel" Spacing="8" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="BuilderForestsDomainsSection"
                            Padding="8"
                            Background="{StaticResource ShellContentBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Forests &amp; Domains" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BuilderAddForestButton" Content="Add Forest" />
                                    <Button x:Name="BuilderAddDomainButton" Content="Add Domain" />
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" x:Name="BuilderForestDomainResourcesListPanel" Spacing="6" />
                                    <StackPanel Grid.Column="1" x:Name="BuilderSelectedForestDomainDetailPanel" Spacing="8" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="BuilderCredentialsSection"
                            Padding="8"
                            Background="{StaticResource ShellContentBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Credentials" />
                                    <Button x:Name="BuilderAddCredentialSlotButton" Content="Add Slot Reference" />
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" x:Name="BuilderCredentialSlotsListPanel" Spacing="6" />
                                    <StackPanel Grid.Column="1" x:Name="BuilderSelectedCredentialSlotDetailPanel" Spacing="8" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="BuilderVmsSection"
                            Padding="8"
                            Background="{StaticResource ShellContentBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <StackPanel x:Name="BuilderVmOverviewPanel" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="VM Overview" />
                                        <Button x:Name="BuilderAddVmButton" Content="Add VM" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="8" Background="{StaticResource ShellBackgroundBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Total VMs" />
                                                <TextBlock x:Name="BuilderVmTotalCountTextBlock" Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Padding="8" Background="{StaticResource ShellBackgroundBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Membership" />
                                                <TextBlock x:Name="BuilderVmMembershipCountsTextBlock" Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Standalone 0 / Domain 0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="8" Background="{StaticResource ShellBackgroundBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="AD DC Roles" />
                                                <TextBlock x:Name="BuilderVmAdDcCountTextBlock" Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="BuilderVmOverviewListPanel" Spacing="6" />
                                </StackPanel>

                                <Grid
                                    x:Name="BuilderSelectedVmDetailHost"
                                    ColumnSpacing="10"
                                    Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" x:Name="BuilderSelectedVmDetailPanel" Spacing="8" />
                                    <StackPanel Grid.Column="1" x:Name="BuilderVmDetailCategoryNavPanel" Spacing="6" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="BuilderReviewSection"
                            Padding="8"
                            Background="{StaticResource ShellContentBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Review" />
                                <TextBlock
                                    x:Name="BuilderReviewSummaryTextBlock"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="BuilderReviewBlockerTextBlock"
                                    Foreground="{StaticResource ShellCriticalBrush}"
                                    Text="At least one VM is required before Save."
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BuilderBackToLibraryButton" Content="Back" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BuilderPreviousStepButton" Content="Previous" />
                        <Button
                            x:Name="BuilderNextStepButton"
                            Background="{StaticResource ShellAccentBrush}"
                            Content="Next"
                            Foreground="{StaticResource ShellTopBarForegroundBrush}" />
                        <Button x:Name="BuilderSaveAsButton" Content="Save As" Visibility="Collapsed" />
                        <Button
                            x:Name="BuilderSaveButton"
                            Background="{StaticResource ShellAccentBrush}"
                            Content="Save"
                            Foreground="{StaticResource ShellTopBarForegroundBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="BuilderStatusTextBlock"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="Create or open a V2 Builder draft."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
