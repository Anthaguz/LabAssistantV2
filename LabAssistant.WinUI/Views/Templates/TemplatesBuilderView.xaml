<UserControl
    x:Class="LabAssistant.WinUI.Views.Templates.TemplatesBuilderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        VerticalAlignment="Stretch">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="V2 Template Builder" />
                <TextBlock
                    x:Name="BuilderContextTextBlock"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="No Builder draft loaded."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="BuilderReferenceTextBlock"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="No reference data loaded."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Margin="0,0,10,0">
                    <Border
                        Padding="8"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Template Name" />
                                <TextBox x:Name="BuilderTemplateNameTextBox" PlaceholderText="Template name" />
                                <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Description" />
                                <TextBox
                                    x:Name="BuilderTemplateDescriptionTextBox"
                                    AcceptsReturn="True"
                                    MinHeight="56"
                                    MaxHeight="96"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Deployment Profile" />
                                <ComboBox x:Name="BuilderDeploymentProfileComboBox">
                                    <ComboBoxItem Content="Conservative" />
                                    <ComboBoxItem Content="Balanced" />
                                    <ComboBoxItem Content="Aggressive" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Padding="8"
                            Background="{StaticResource ShellContentBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Lab Networks" />
                                <TextBox
                                    x:Name="BuilderLabNetworksTextBox"
                                    AcceptsReturn="True"
                                    MinHeight="96"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="8"
                            Background="{StaticResource ShellContentBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="6">
                                <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Forests" />
                                <TextBox
                                    x:Name="BuilderForestsTextBox"
                                    AcceptsReturn="True"
                                    MinHeight="96"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Padding="8"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Domains" />
                            <TextBox
                                x:Name="BuilderDomainsTextBox"
                                AcceptsReturn="True"
                                MinHeight="108"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="VM Topology and Credentials" />
                            <TextBox
                                x:Name="BuilderVmsTextBox"
                                AcceptsReturn="True"
                                MinHeight="132"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="8"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="VM NIC/IP/DNS/Gateway" />
                            <TextBox
                                x:Name="BuilderNicsTextBox"
                                AcceptsReturn="True"
                                MinHeight="132"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="6">
                <CheckBox
                    x:Name="BuilderConfirmSaveCheckBox"
                    Content="I confirm this visible V2 Builder draft should be persisted." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BuilderApplySuggestionsButton" Content="Apply Suggestions" />
                    <Button x:Name="BuilderValidateButton" Content="Validate" />
                    <Button x:Name="BuilderSaveButton" Content="Save" />
                    <Button x:Name="BuilderSaveAsButton" Content="Save As" />
                    <Button x:Name="BuilderBackToLibraryButton" Content="Back to Library" />
                </StackPanel>
                <TextBlock
                    x:Name="BuilderStatusTextBlock"
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="Create or open a V2 Builder draft."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
