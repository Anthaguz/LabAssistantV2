<UserControl
    x:Class="LabAssistant.WinUI.Views.Templates.TemplatesLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel Spacing="10">
            <TextBlock
                Foreground="{StaticResource ShellTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Template Library (Scaffold)" />
            <TextBlock
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="AD2 scaffold: list/search/actions only. AD3 will wire operations."
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    PlaceholderText="Search templates (placeholder)" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="180"
                    PlaceholderText="Filter (placeholder)" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open" IsEnabled="False" />
                <Button Content="Create" IsEnabled="False" />
                <Button Content="Import" IsEnabled="False" />
                <Button Content="Export" IsEnabled="False" />
            </StackPanel>

            <ListView Height="220">
                <ListViewItem Content="Template placeholder A" />
                <ListViewItem Content="Template placeholder B" />
                <ListViewItem Content="Template placeholder C" />
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
