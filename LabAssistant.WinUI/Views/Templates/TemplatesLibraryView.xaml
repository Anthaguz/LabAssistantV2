<UserControl
    x:Class="LabAssistant.WinUI.Views.Templates.TemplatesLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel Spacing="10">
            <TextBlock
                Foreground="{StaticResource ShellTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Template Library" />
            <TextBlock
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="Browse, open, import, export, create, and delete templates from one capability surface."
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="TemplateSearchTextBox"
                    Grid.Column="0"
                    PlaceholderText="Search by name, id, or description" />
                <Button
                    x:Name="ApplyTemplateSearchButton"
                    Grid.Column="1"
                    Content="Apply" />
                <Button
                    x:Name="ClearTemplateSearchButton"
                    Grid.Column="2"
                    Content="Clear" />
                <Button
                    x:Name="ReloadTemplatesButton"
                    Grid.Column="3"
                    Content="Reload" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenTemplateInEditorButton" Content="Open in Editor" />
                <Button x:Name="CreateTemplateButton" Content="Create New" />
                <Button x:Name="DeleteTemplateButton" Content="Delete" />
                <Button x:Name="ImportTemplateButton" Content="Import" />
                <Button x:Name="ExportTemplateButton" Content="Export" />
            </StackPanel>

            <Border
                Height="260"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ListView x:Name="TemplateLibraryListView" Padding="8" SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="10"
                                Background="{StaticResource ShellBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                                        Text="{Binding Description}"
                                        TextWrapping="WrapWholeWords" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="VMs:" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="{Binding VmCount}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <TextBlock
                x:Name="TemplatesLibraryStatusTextBlock"
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="No templates loaded."
                TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
