<UserControl
    x:Class="LabAssistant.WinUI.Views.Templates.TemplatesEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{StaticResource ShellBackgroundBrush}"
        BorderBrush="{StaticResource ShellBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <StackPanel Spacing="10">
            <TextBlock
                Foreground="{StaticResource ShellTextPrimaryBrush}"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Template Editor (Scaffold)" />
            <TextBlock
                Foreground="{StaticResource ShellTextSecondaryBrush}"
                Text="AD2 scaffold: editor sections and save actions are placeholders. AD3 will wire template operations."
                TextWrapping="Wrap" />

            <Border
                Padding="8"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock
                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                    Text="Selected template context: (placeholder)"
                    TextWrapping="Wrap" />
            </Border>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Metadata Section" />
                    <TextBox PlaceholderText="Template name (placeholder)" />
                    <TextBox PlaceholderText="Description (placeholder)" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="VM Definitions Section" />
                    <TextBox PlaceholderText="VM item editor (placeholder)" />
                    <TextBox PlaceholderText="Network/base disk references (placeholder)" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" IsEnabled="False" />
                <Button Content="Save As" IsEnabled="False" />
                <Button Content="Validate" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
