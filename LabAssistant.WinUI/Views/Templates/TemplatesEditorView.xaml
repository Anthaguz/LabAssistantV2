<UserControl
    x:Class="LabAssistant.WinUI.Views.Templates.TemplatesEditorView"
    x:Name="TemplatesEditorViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:LabAssistant.WinUI.ViewModels.Templates">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Text="Template Editor" />
            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.ContextText, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.TemplateIdText, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.FilePathText, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SlotCountText, Mode=OneWay}" TextWrapping="Wrap" />
            <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
            <TextBlock Foreground="{StaticResource ShellCriticalBrush}" Text="{x:Bind ViewModel.ErrorStateText, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />
            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="12" Background="{StaticResource ShellBackgroundBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Template name" />
                    <TextBox Text="{x:Bind ViewModel.TemplateName, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Description" />
                    <TextBox AcceptsReturn="True" MinHeight="72" MaxHeight="120" Text="{x:Bind ViewModel.Description, Mode=TwoWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" Background="{StaticResource ShellBackgroundBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="Template VM slots" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Slots, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSlot, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TemplateSlotItem">
                                <StackPanel Padding="8" Spacing="4">
                                    <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" />
                                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind Description, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.AddSlotCommand}" Content="Add Slot" IsEnabled="{x:Bind ViewModel.CanAddSlot, Mode=OneWay}" />
                        <Button Command="{x:Bind ViewModel.RemoveSlotCommand}" Content="Remove Slot" IsEnabled="{x:Bind ViewModel.CanRemoveSlot, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="12" Background="{StaticResource ShellBackgroundBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <ScrollViewer Visibility="{x:Bind ViewModel.SelectedSlotVisibility, Mode=OneWay}">
                        <StackPanel Margin="0,0,10,0" Spacing="8">
                            <TextBlock Foreground="{StaticResource ShellTextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedSlotHeading, Mode=OneWay}" />
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedSlotSummary, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SlotIdText, Mode=OneWay}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Name" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SlotName, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Memory (MB)" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SlotMemoryText, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="CPU count" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SlotCpuText, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Switches" />
                                <TextBox Grid.Column="1" PlaceholderText="Comma-separated switch names" Text="{x:Bind ViewModel.SlotSwitchesText, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.SwitchGuidanceText, Mode=OneWay}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Base disk id" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SlotBaseDiskId, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Base disk path" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SlotBaseDiskPath, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Generation" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SlotGenerationText, Mode=TwoWay}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="VHDX signature" />
                                <TextBox Grid.Column="1" Text="{x:Bind ViewModel.SlotVhdxSignature, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{x:Bind ViewModel.BaseDiskGuidanceText, Mode=OneWay}" TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Command="{x:Bind ViewModel.ApplySlotChangesCommand}" Content="Apply Slot Changes" IsEnabled="{x:Bind ViewModel.CanApplySlotChanges, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Select a VM slot to edit its configuration." TextWrapping="Wrap" Visibility="{x:Bind ViewModel.NoSelectionVisibility, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.SaveCommand}" Content="Save" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.ValidateCommand}" Content="Validate" IsEnabled="{x:Bind ViewModel.CanValidate, Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.CancelCommand}" Content="Cancel" IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
