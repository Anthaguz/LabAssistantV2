<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellContentBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="ElevatedCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource ElevationLevel2BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ElevationLevel2BorderThickness}" />
    </Style>

    <Style x:Key="SubtleCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{StaticResource ShellBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ElevationLevel1BorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ElevationLevel1BorderThickness}" />
    </Style>
</ResourceDictionary>
