<Window
    x:Class="LabAssistant.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FFF4F6FA">
        <Border
            Margin="24"
            Padding="20"
            Background="White"
            BorderBrush="#FFE5E7EB"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="10">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="LabAssistant WinUI" />
                <TextBlock
                    Foreground="#FF4B5563"
                    Text="Parallel WinUI host wiring is ready. Shell migration behavior is intentionally out of scope for #265." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
