<Window
    x:Class="LabAssistant.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:deployViews="using:LabAssistant.WinUI.Views.Deploy"
    xmlns:machineViews="using:LabAssistant.WinUI.Views.Machines"
    xmlns:templateViews="using:LabAssistant.WinUI.Views.Templates">
    <Grid x:Name="RootLayout" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource ShellTopBarBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="ShellBrandingImage"
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="LabAssistant application icon"
                    Visibility="Collapsed" />

                <Button
                    x:Name="HamburgerButton"
                    Grid.Column="1"
                    Width="36"
                    Height="32"
                    Click="HamburgerButton_Click"
                    Content=" "
                    FontFamily="Segoe MDL2 Assets"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    ToolTipService.ToolTip="Toggle navigation pane" />

                <TextBlock
                    x:Name="CurrentRouteTextBlock"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    Text="Machines / Overview" />

                <Button
                    x:Name="ThemeToggleButton"
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    Click="ThemeToggleButton_Click"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    Content="Switch to dark">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource ShellTopBarForegroundColor}" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource ShellTopBarForegroundColor}" />
                    </Button.Resources>
                </Button>

                <Grid Grid.Column="5" Margin="8,0,0,0">
                    <Button
                        x:Name="InsightsToggleButton"
                        Width="44"
                        Height="32"
                        Click="InsightsButton_Click"
                        Content=" "
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{StaticResource ShellTopBarForegroundBrush}"
                        ToolTipService.ToolTip="Toggle details panel" />
                    <Border
                        x:Name="IssueBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MinWidth="18"
                        Height="18"
                        Background="{StaticResource ShellCriticalBrush}"
                        CornerRadius="9"
                        Visibility="Visible">
                        <TextBlock
                            x:Name="IssueBadgeTextBlock"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellTopBarForegroundBrush}"
                            FontSize="11"
                            Text="3" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ShellRightPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <NavigationView
                x:Name="GlobalNavigationView"
                Grid.Column="0"
                CompactPaneLength="56"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                OpenPaneLength="280"
                PaneDisplayMode="LeftCompact"
                ItemInvoked="GlobalNavigationView_ItemInvoked">
                <NavigationView.Content>
                    <Border
                        Margin="16"
                        Padding="20"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="ContentTitleTextBlock"
                                Grid.Row="0"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Machines Shell Host" />
                            <TextBlock
                                x:Name="ContentDescriptionTextBlock"
                                Grid.Row="1"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Machines feature content is intentionally out of scope for #266."
                                TextWrapping="Wrap" />
                            <Border
                                x:Name="DeployLocalNavigationPanel"
                                Grid.Row="2"
                                Padding="8"
                                Background="{StaticResource ShellContentBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                                <TabView
                                    x:Name="DeploySubviewTabView"
                                    IsAddTabButtonVisible="False">
                                    <TabViewItem x:Name="DeployOverviewTabViewItem" Header="Overview" IsClosable="False">
                                        <deployViews:DeployOverviewView x:Name="DeployOverviewViewHost" />
                                    </TabViewItem>
                                    <TabViewItem x:Name="DeployQuickDeployTabViewItem" Header="Quick Deploy" IsClosable="False">
                                        <deployViews:DeployOnTheFlyView
                                            x:Name="DeployOnTheFlyViewHost"
                                            Visibility="Collapsed" />
                                    </TabViewItem>
                                    <TabViewItem x:Name="DeployFromTemplateTabViewItem" Header="From Template" IsClosable="False">
                                        <deployViews:DeployFromTemplateView
                                            x:Name="DeployFromTemplateViewHost"
                                            Visibility="Collapsed" />
                                    </TabViewItem>
                                </TabView>
                            </Border>
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Frame
                                    x:Name="CapabilityFrame"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    IsNavigationStackEnabled="False"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="TemplatesWorkspacePanel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="8"
                                    Background="{StaticResource ShellContentBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    VerticalAlignment="Stretch"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <templateViews:TemplatesLibraryView
                                            x:Name="TemplatesLibraryViewHost"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Visibility="Collapsed" />
                                        <templateViews:TemplatesEditorView
                                            x:Name="TemplatesEditorViewHost"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Visibility="Collapsed" />
                                        <templateViews:TemplatesBuilderView
                                            x:Name="TemplatesBuilderViewHost"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Border
                                    x:Name="SettingsMachinesPanel"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Padding="12"
                                    Background="{StaticResource ShellBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="Machines Deletion Policy" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="Sets the default delete scope for Machines. Confirmation still shows effective scope before delete."
                                            TextWrapping="Wrap" />
                                        <ComboBox x:Name="MachinesDeletionPolicyComboBox" Width="420">
                                            <ComboBoxItem Tag="AskEveryTime" Content="Ask every time (default)" />
                                            <ComboBoxItem Tag="AlwaysDeleteDisks" Content="Always delete disks" />
                                            <ComboBoxItem Tag="AlwaysDeleteDisksForLabAssistantProvisioned" Content="Always delete disks for LabAssistant-provisioned VMs" />
                                            <ComboBoxItem Tag="AlwaysDeleteDisksForDifferencingOnly" Content="Always delete disks for differencing disks only" />
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="SaveMachinesDeletionPolicyButton" Click="SaveMachinesDeletionPolicyButton_Click" Content="Save policy" />
                                            <TextBlock
                                                x:Name="MachinesDeletionPolicyStatusTextBlock"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                Text="Policy not loaded." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    x:Name="NonMachinesPlaceholderTextBlock"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Select a capability to continue."
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>
                </NavigationView.Content>
            </NavigationView>

            <Border
                x:Name="InsightsPanel"
                Grid.Column="1"
                Margin="0,16,16,16"
                Padding="12"
                Background="{StaticResource ShellInsightsBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="RightPanelTitleTextBlock"
                            Grid.Column="0"
                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Details" />
                        <Button
                            x:Name="CloseRightPanelButton"
                            Grid.Column="1"
                            MinWidth="34"
                            Height="30"
                            Padding="8,0"
                            ToolTipService.ToolTip="Close details panel"
                            Click="CloseRightPanelButton_Click">
                            <FontIcon Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <deployViews:DeployFromTemplateRightPanelView
                                x:Name="DeployFromTemplateRightPanelViewHost"
                                Visibility="Collapsed" />
                            <deployViews:DeployOnTheFlyRightPanelView
                                x:Name="DeployOnTheFlyRightPanelViewHost"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="RightPanelEmptyStateBorder"
                                Padding="10"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                                <TextBlock
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Progress and results appear here when the active workflow uses the details panel."
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
