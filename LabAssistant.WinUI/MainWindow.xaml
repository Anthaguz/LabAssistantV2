<Window
    x:Class="LabAssistant.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootLayout" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource ShellTopBarBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="HamburgerButton"
                    Grid.Column="0"
                    Width="36"
                    Height="32"
                    Click="HamburgerButton_Click"
                    Content=" "
                    FontFamily="Segoe MDL2 Assets"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    ToolTipService.ToolTip="Open capabilities" />

                <TextBlock
                    x:Name="BreadcrumbTextBlock"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    Text="Capability / Machines" />

                <Button
                    x:Name="ThemeToggleButton"
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Click="ThemeToggleButton_Click"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    Content="Switch to dark">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource ShellTopBarForegroundColor}" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource ShellTopBarForegroundColor}" />
                    </Button.Resources>
                </Button>

                <Grid Grid.Column="4" Margin="8,0,0,0">
                    <Button
                        x:Name="InsightsToggleButton"
                        Width="44"
                        Height="32"
                        Click="InsightsButton_Click"
                        Content=" "
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{StaticResource ShellTopBarForegroundBrush}"
                        ToolTipService.ToolTip="Toggle insights panel" />
                    <Border
                        x:Name="IssueBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MinWidth="18"
                        Height="18"
                        Background="{StaticResource ShellCriticalBrush}"
                        CornerRadius="9"
                        Visibility="Visible">
                        <TextBlock
                            x:Name="IssueBadgeTextBlock"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellTopBarForegroundBrush}"
                            FontSize="11"
                            Text="3" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource ShellRailBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0" Spacing="4">
                    <Button x:Name="MachinesRailButton" Width="48" Height="44" Margin="8,0,8,0" Click="CapabilityButton_Click" Content=" " Tag="Machines" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ShellTopBarForegroundBrush}" ToolTipService.ToolTip="Machines" />
                    <Button x:Name="DeployRailButton" Width="48" Height="44" Margin="8,0,8,0" Click="CapabilityButton_Click" Content=" " Tag="Deploy" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ShellTopBarForegroundBrush}" ToolTipService.ToolTip="Deploy" />
                    <Button x:Name="TemplatesRailButton" Width="48" Height="44" Margin="8,0,8,0" Click="CapabilityButton_Click" Content=" " Tag="Templates" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ShellTopBarForegroundBrush}" ToolTipService.ToolTip="Templates" />
                    <Button x:Name="AssetsRailButton" Width="48" Height="44" Margin="8,0,8,0" Click="CapabilityButton_Click" Content=" " Tag="Assets" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ShellTopBarForegroundBrush}" ToolTipService.ToolTip="Assets" />
                    <Button x:Name="DiagnosticsRailButton" Width="48" Height="44" Margin="8,0,8,0" Click="CapabilityButton_Click" Content=" " Tag="Diagnostics" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ShellTopBarForegroundBrush}" ToolTipService.ToolTip="Diagnostics" />
                    <Button x:Name="SettingsRailButton" Width="48" Height="44" Margin="8,0,8,0" Click="CapabilityButton_Click" Content=" " Tag="Settings" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource ShellTopBarForegroundBrush}" ToolTipService.ToolTip="Settings" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="16"
                Padding="20"
                Background="{StaticResource ShellContentBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="ContentTitleTextBlock"
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Machines Shell Host" />
                    <Border
                        Padding="8"
                        Background="{StaticResource ShellBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                x:Name="SubviewSelectorPanel"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center" />
                            <StackPanel
                                x:Name="SubviewToolbarPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="ContentDescriptionTextBlock"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Machines feature content is intentionally out of scope for #266."
                        TextWrapping="Wrap" />
                    <Grid x:Name="MachinesOverviewPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Padding="8"
                            Background="{StaticResource ShellBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="Host VMs" />
                                    <Button
                                        x:Name="RefreshMachinesButton"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="RefreshMachinesButton_Click"
                                        Content="Refresh" />
                                </StackPanel>
                                <ListView
                                    x:Name="MachinesListView"
                                    Height="360"
                                    SelectionChanged="MachinesListView_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                                    Text="{Binding VmName}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                    Text="{Binding State}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                    Text="{Binding OriginLabel}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Padding="12"
                            Background="{StaticResource ShellBackgroundBrush}"
                            BorderBrush="{StaticResource ShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="VM Details" />
                                <TextBlock x:Name="SelectedVmNameTextBlock" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="Name: (none)" />
                                <TextBlock x:Name="SelectedVmStateTextBlock" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="State: -" />
                                <TextBlock x:Name="SelectedVmOriginTextBlock" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Origin: -" />
                                <TextBlock x:Name="SelectedVmIdTextBlock" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="VM Id: -" TextWrapping="Wrap" />
                                <TextBlock x:Name="SelectedVmPathTextBlock" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Path: -" TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                    FontWeight="SemiBold"
                                    Text="Basic Edit" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="CPU Count" />
                                    <TextBox x:Name="CpuCountTextBox" Grid.Column="1" TextChanged="CpuCountTextBox_TextChanged" />
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Startup Memory (MB)" />
                                    <TextBox x:Name="StartupMemoryTextBox" Grid.Column="1" TextChanged="StartupMemoryTextBox_TextChanged" />
                                </Grid>

                                <ToggleSwitch x:Name="DynamicMemoryToggle" Toggled="DynamicMemoryToggle_Toggled" Header="Dynamic Memory" />

                                <Grid x:Name="DynamicMemoryPanel" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Min (MB)" />
                                    <TextBox x:Name="MinimumMemoryTextBox" Grid.Row="0" Grid.Column="1" TextChanged="MinimumMemoryTextBox_TextChanged" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Max (MB)" />
                                    <TextBox x:Name="MaximumMemoryTextBox" Grid.Row="1" Grid.Column="1" TextChanged="MaximumMemoryTextBox_TextChanged" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Buffer (%)" />
                                    <TextBox x:Name="MemoryBufferTextBox" Grid.Row="2" Grid.Column="1" TextChanged="MemoryBufferTextBox_TextChanged" />
                                </Grid>

                                <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Network Adapters" />
                                <StackPanel x:Name="NetworkAdapterEditorPanel" Spacing="6" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ApplyMachineEditsButton" Click="ApplyMachineEditsButton_Click" Content="Apply" />
                                    <TextBlock
                                        x:Name="MachineEditDirtyTextBlock"
                                        Foreground="{StaticResource ShellWarnBrush}"
                                        VerticalAlignment="Center"
                                        Text="Unsaved changes"
                                        Visibility="Collapsed" />
                                </StackPanel>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                    FontWeight="SemiBold"
                                    Text="Actions" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="StartVmButton" Click="StartVmButton_Click" Content="Start VM" />
                                    <Button x:Name="StopVmButton" Click="StopVmButton_Click" Content="Stop VM" />
                                    <Button x:Name="RestartVmButton" Click="RestartVmButton_Click" Content="Restart VM" />
                                    <Button x:Name="OpenConsoleButton" Click="OpenConsoleButton_Click" Content="Open Console" />
                                    <Button x:Name="DeleteVmButton" Click="DeleteVmButton_Click" Content="Delete VM" />
                                    <Button x:Name="OpenRdpButton" Click="OpenRdpButton_Click" IsEnabled="False" Content="Open RDP" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="RdpReadinessTextBlock"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    FontStyle="Italic"
                                    Text="RDP readiness unknown."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="MachinesStatusTextBlock"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Select a VM to run actions."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border
                        x:Name="SettingsMachinesPanel"
                        Padding="12"
                        Background="{StaticResource ShellBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Machines Deletion Policy" />
                            <TextBlock
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Sets the default delete scope for Machines. Confirmation still shows effective scope before delete."
                                TextWrapping="Wrap" />
                            <ComboBox x:Name="MachinesDeletionPolicyComboBox" Width="420">
                                <ComboBoxItem Tag="AskEveryTime" Content="Ask every time (default)" />
                                <ComboBoxItem Tag="AlwaysDeleteDisks" Content="Always delete disks" />
                                <ComboBoxItem Tag="AlwaysDeleteDisksForLabAssistantProvisioned" Content="Always delete disks for LabAssistant-provisioned VMs" />
                                <ComboBoxItem Tag="AlwaysDeleteDisksForDifferencingOnly" Content="Always delete disks for differencing disks only" />
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveMachinesDeletionPolicyButton" Click="SaveMachinesDeletionPolicyButton_Click" Content="Save policy" />
                                <TextBlock
                                    x:Name="MachinesDeletionPolicyStatusTextBlock"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Policy not loaded." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="DiagnosticsLogsPanel"
                        Padding="12"
                        Background="{StaticResource ShellBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="8">
                                <TextBlock
                                    Foreground="{StaticResource ShellTextPrimaryBrush}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Structured Logs" />
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBox x:Name="LogFilterOperationIdTextBox" Grid.Row="0" Grid.Column="0" Width="180" PlaceholderText="OperationId" />
                                        <TextBox x:Name="LogFilterLevelTextBox" Grid.Row="0" Grid.Column="1" Width="120" PlaceholderText="Level" />
                                        <TextBox x:Name="LogFilterEventTextBox" Grid.Row="0" Grid.Column="2" Width="180" PlaceholderText="Event" />
                                        <TextBox x:Name="LogFilterTextSearchTextBox" Grid.Row="0" Grid.Column="3" Width="220" PlaceholderText="Text search" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <CheckBox x:Name="LogFilterUseStartDateCheckBox" VerticalAlignment="Center" Content="Start" />
                                            <DatePicker x:Name="LogFilterStartDatePicker" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <CheckBox x:Name="LogFilterUseEndDateCheckBox" VerticalAlignment="Center" Content="End" />
                                            <DatePicker x:Name="LogFilterEndDatePicker" />
                                        </StackPanel>
                                        <Button x:Name="ApplyLogFiltersButton" Grid.Row="1" Grid.Column="2" Click="ApplyLogFiltersButton_Click" Content="Apply filters" />
                                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ClearLogFiltersButton" Click="ClearLogFiltersButton_Click" Content="Clear filters" />
                                            <Button x:Name="ReloadLogsButton" Click="ReloadLogsButton_Click" Content="Reload" />
                                            <Button x:Name="OpenRawJsonlButton" Click="OpenRawJsonlButton_Click" Content="Open raw JSONL" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <TextBlock
                                    x:Name="LogsStatusTextBlock"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Logs not loaded yet."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <ListView
                                x:Name="StructuredLogsListView"
                                Grid.Row="1"
                                Grid.Column="0"
                                SelectionChanged="StructuredLogsListView_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Foreground="{StaticResource ShellTextPrimaryBrush}" Text="{Binding TimestampText}" />
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Level}" />
                                            <TextBlock Grid.Column="2" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Event}" />
                                            <TextBlock Grid.Column="3" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding OperationId}" />
                                            <TextBlock Grid.Column="4" Foreground="{StaticResource ShellTextSecondaryBrush}" Text="{Binding Result}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="8"
                                Background="{StaticResource ShellContentBackgroundBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Text="Selected Context" />
                                    <ScrollViewer
                                        Grid.Row="1"
                                        MaxHeight="88"
                                        VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            x:Name="SelectedLogEnvelopeTextBlock"
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="Select a log entry."
                                            TextWrapping="WrapWholeWords" />
                                    </ScrollViewer>
                                    <TextBox
                                        x:Name="SelectedLogContextTextBox"
                                        Grid.Row="2"
                                        AcceptsReturn="True"
                                        IsReadOnly="True"
                                        TextWrapping="NoWrap"
                                        VerticalAlignment="Stretch"
                                        FontFamily="Consolas"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="NonMachinesPlaceholderTextBlock"
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        Text="Subview placeholder content."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{StaticResource ShellTextSecondaryBrush}"
                        FontStyle="Italic"
                        Text="AA2b scaffold-only: capability-local navigation, toolbar placeholders, and routing context. Feature operations remain out of scope." />
                </StackPanel>
            </Border>

            <Border
                x:Name="InsightsPanel"
                Grid.Column="2"
                Margin="0,16,16,16"
                Padding="16"
                Background="{StaticResource ShellInsightsBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Insights" />
                    <Border Padding="8" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Readiness has 2 blocking items." TextWrapping="Wrap" />
                    </Border>
                    <Border Padding="8" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Diagnostics export completed with warnings." TextWrapping="Wrap" />
                    </Border>
                    <Border Padding="8" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="One VM has pending guest-step configuration." TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border
            x:Name="DrawerScrim"
            Grid.Row="1"
            Background="{StaticResource ShellScrimBrush}"
            Tapped="DrawerScrim_Tapped"
            Visibility="Collapsed" />

        <Border
            x:Name="CapabilityDrawer"
            Grid.Row="1"
            Width="280"
            HorizontalAlignment="Left"
            Padding="16"
            Background="{StaticResource ShellDrawerBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="0,0,1,0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslateTransform" X="-280" />
            </Border.RenderTransform>
            <StackPanel Spacing="6">
                <TextBlock Foreground="{StaticResource ShellTopBarForegroundBrush}" FontSize="18" FontWeight="SemiBold" Text="Capabilities" />
                <Button x:Name="MachinesDrawerButton" Click="CapabilityButton_Click" Content="Machines" Tag="Machines" />
                <Button x:Name="DeployDrawerButton" Click="CapabilityButton_Click" Content="Deploy" Tag="Deploy" />
                <Button x:Name="TemplatesDrawerButton" Click="CapabilityButton_Click" Content="Templates" Tag="Templates" />
                <Button x:Name="AssetsDrawerButton" Click="CapabilityButton_Click" Content="Assets" Tag="Assets" />
                <Button x:Name="DiagnosticsDrawerButton" Click="CapabilityButton_Click" Content="Diagnostics" Tag="Diagnostics" />
                <Button x:Name="SettingsDrawerButton" Click="CapabilityButton_Click" Content="Settings" Tag="Settings" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
