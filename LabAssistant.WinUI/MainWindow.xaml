<Window
    x:Class="LabAssistant.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:diagViews="using:LabAssistant.WinUI.Views.Diagnostics"
    xmlns:machineViews="using:LabAssistant.WinUI.Views.Machines"
    xmlns:templateViews="using:LabAssistant.WinUI.Views.Templates">
    <Grid x:Name="RootLayout" Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource ShellTopBarBackgroundBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Padding="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="HamburgerButton"
                    Grid.Column="0"
                    Width="36"
                    Height="32"
                    Click="HamburgerButton_Click"
                    Content=" "
                    FontFamily="Segoe MDL2 Assets"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    ToolTipService.ToolTip="Toggle navigation pane" />

                <TextBlock
                    x:Name="CurrentRouteTextBlock"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    Text="Machines / Overview" />

                <Button
                    x:Name="ThemeToggleButton"
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    Click="ThemeToggleButton_Click"
                    Foreground="{StaticResource ShellTopBarForegroundBrush}"
                    Content="Switch to dark">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource ShellTopBarForegroundColor}" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource ShellTopBarForegroundColor}" />
                    </Button.Resources>
                </Button>

                <Grid Grid.Column="4" Margin="8,0,0,0">
                    <Button
                        x:Name="InsightsToggleButton"
                        Width="44"
                        Height="32"
                        Click="InsightsButton_Click"
                        Content=" "
                        FontFamily="Segoe MDL2 Assets"
                        Foreground="{StaticResource ShellTopBarForegroundBrush}"
                        ToolTipService.ToolTip="Toggle insights panel" />
                    <Border
                        x:Name="IssueBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MinWidth="18"
                        Height="18"
                        Background="{StaticResource ShellCriticalBrush}"
                        CornerRadius="9"
                        Visibility="Visible">
                        <TextBlock
                            x:Name="IssueBadgeTextBlock"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellTopBarForegroundBrush}"
                            FontSize="11"
                            Text="3" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <NavigationView
                x:Name="GlobalNavigationView"
                Grid.Column="0"
                CompactPaneLength="56"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                OpenPaneLength="280"
                PaneDisplayMode="LeftCompact"
                ItemInvoked="GlobalNavigationView_ItemInvoked">
                <NavigationView.Content>
                    <Border
                        Margin="16"
                        Padding="20"
                        Background="{StaticResource ShellContentBackgroundBrush}"
                        BorderBrush="{StaticResource ShellBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="ContentTitleTextBlock"
                                Grid.Row="0"
                                Foreground="{StaticResource ShellTextPrimaryBrush}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Machines Shell Host" />
                            <TextBlock
                                x:Name="ContentDescriptionTextBlock"
                                Grid.Row="1"
                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                Text="Machines feature content is intentionally out of scope for #266."
                                TextWrapping="Wrap" />
                            <Grid Grid.Row="2">
                                <machineViews:MachinesOverviewView
                                    x:Name="MachinesOverviewViewHost"
                                    Visibility="Collapsed" />
                                <Border
                                    x:Name="TemplatesLocalNavigationPanel"
                                    Padding="8"
                                    Background="{StaticResource ShellContentBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <TabView
                                        x:Name="TemplatesSubviewTabView"
                                        IsAddTabButtonVisible="False"
                                        SelectionChanged="TemplatesSubviewTabView_SelectionChanged">
                                        <TabView.Resources>
                                            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="{ThemeResource ShellBackgroundColor}" />
                                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource ShellContentBackgroundColor}" />
                                            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="{ThemeResource ShellTextSecondaryColor}" />
                                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="{ThemeResource ShellTextPrimaryColor}" />
                                            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{ThemeResource ShellBackgroundColor}" />
                                            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="{ThemeResource ShellTextPrimaryColor}" />
                                        </TabView.Resources>
                                        <TabViewItem x:Name="TemplatesLibraryTabViewItem" Header="Library" IsClosable="False">
                                            <templateViews:TemplatesLibraryView x:Name="TemplatesLibraryViewHost" />
                                        </TabViewItem>
                                        <TabViewItem x:Name="TemplatesEditorTabViewItem" Header="Editor" IsClosable="False">
                                            <templateViews:TemplatesEditorView x:Name="TemplatesEditorViewHost" />
                                        </TabViewItem>
                                    </TabView>
                                </Border>
                                <Border
                                    x:Name="SettingsMachinesPanel"
                                    Padding="12"
                                    Background="{StaticResource ShellBackgroundBrush}"
                                    BorderBrush="{StaticResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextPrimaryBrush}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="Machines Deletion Policy" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellTextSecondaryBrush}"
                                            Text="Sets the default delete scope for Machines. Confirmation still shows effective scope before delete."
                                            TextWrapping="Wrap" />
                                        <ComboBox x:Name="MachinesDeletionPolicyComboBox" Width="420">
                                            <ComboBoxItem Tag="AskEveryTime" Content="Ask every time (default)" />
                                            <ComboBoxItem Tag="AlwaysDeleteDisks" Content="Always delete disks" />
                                            <ComboBoxItem Tag="AlwaysDeleteDisksForLabAssistantProvisioned" Content="Always delete disks for LabAssistant-provisioned VMs" />
                                            <ComboBoxItem Tag="AlwaysDeleteDisksForDifferencingOnly" Content="Always delete disks for differencing disks only" />
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="SaveMachinesDeletionPolicyButton" Click="SaveMachinesDeletionPolicyButton_Click" Content="Save policy" />
                                            <TextBlock
                                                x:Name="MachinesDeletionPolicyStatusTextBlock"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource ShellTextSecondaryBrush}"
                                                Text="Policy not loaded." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <diagViews:DiagnosticsLogsView
                                    x:Name="DiagnosticsLogsViewHost"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="NonMachinesPlaceholderTextBlock"
                                    Foreground="{StaticResource ShellTextSecondaryBrush}"
                                    Text="Subview placeholder content."
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>
                </NavigationView.Content>
            </NavigationView>

            <Border
                x:Name="InsightsPanel"
                Grid.Column="1"
                Margin="0,16,16,16"
                Padding="16"
                Background="{StaticResource ShellInsightsBackgroundBrush}"
                BorderBrush="{StaticResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock
                        Foreground="{StaticResource ShellTextPrimaryBrush}"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Insights" />
                    <Border Padding="8" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Readiness has 2 blocking items." TextWrapping="Wrap" />
                    </Border>
                    <Border Padding="8" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="Diagnostics export completed with warnings." TextWrapping="Wrap" />
                    </Border>
                    <Border Padding="8" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TextBlock Foreground="{StaticResource ShellTextSecondaryBrush}" Text="One VM has pending guest-step configuration." TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
