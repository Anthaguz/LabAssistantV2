<Page x:Class="LabAssistant.Views.VmDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:LabAssistant.Views.Controls"
      Title="VmDetailPage"
      Background="{StaticResource SystemPageBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
            <Button Click="BackButton_Click"
                    Content="?"
                    Width="32"
                    Height="32"
                    Style="{StaticResource FluentButtonStyle}"
                    Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Name}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource SystemBaseHighColor}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <controls:VmConfigPanel Grid.Row="1"/>
    </Grid>
</Page>
