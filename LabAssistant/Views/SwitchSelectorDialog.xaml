<Window x:Class="LabAssistant.Views.SwitchSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Virtual Switch" Height="200" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ComboBox x:Name="SwitchesComboBox" VerticalAlignment="Center" Margin="0,0,0,10" />

        <Button Content="Select" Grid.Row="1" Width="100" HorizontalAlignment="Right" Click="SelectButton_Click"/>
    </Grid>
</Window>
