<Page x:Class="LabAssistant.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:LabAssistant.Views"
      Title="SettingsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Template Folder" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox x:Name="TemplateFolderBox" Height="30"/>
            <Button Content="Change Template Folder" Width="190" Margin="0,10,0,0" Click="ChangeTemplateFolder_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Logs Path" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
            <TextBox x:Name="LogsPathBox" Height="30" />
            <Button Content="Change Logs Path" Width="150" Margin="0,10,0,0" Click="ChangeLogsPath_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Deployment Failure Policy" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
            <CheckBox x:Name="PerVmFailFastBox" Content="Stop a VM on first blocking error" Margin="0,0,0,6"/>
            <CheckBox x:Name="StopAllOnAnyVmFailureBox" Content="Stop all VMs if any VM fails" Margin="0,0,0,12"/>

            <TextBlock Text="Non-blocking optional steps" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <CheckBox x:Name="OptionalSetTimeZoneBox" Content="Set Time Zone" Margin="0,0,0,4"/>
            <CheckBox x:Name="OptionalInstallSoftwareBox" Content="Install Software" Margin="0,0,0,4"/>
            <CheckBox x:Name="OptionalInstallRoleBox" Content="Install Role" Margin="0,0,0,4"/>
            <CheckBox x:Name="OptionalConfigureNetworkBox" Content="Configure Network Information" Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reload Settings" Width="120" Margin="0,0,10,0" Click="ReloadSettings_Click"/>
            <Button Content="Save Settings" Width="120" Click="SaveSettings_Click"/>
        </StackPanel>

    </Grid>
</Page>
