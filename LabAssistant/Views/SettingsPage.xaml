<Page x:Class="LabAssistant.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:LabAssistant.Views"
      Title="SettingsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Template Paths" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="TemplatePathsList" Height="120" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Add Path" Width="100" Margin="0,0,10,0" Click="AddPath_Click"/>
                <Button Content="Remove Selected" Width="150" Click="RemovePath_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Logs Path" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
            <TextBox x:Name="LogsPathBox" Height="30" />
            <Button Content="Change Logs Path" Width="150" Margin="0,10,0,0" Click="ChangeLogsPath_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reload Settings" Width="120" Margin="0,0,10,0" Click="ReloadSettings_Click"/>
            <Button Content="Save Settings" Width="120" Click="SaveSettings_Click"/>
        </StackPanel>

    </Grid>
</Page>
