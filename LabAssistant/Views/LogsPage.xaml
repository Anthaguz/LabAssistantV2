<Page x:Class="LabAssistant.Views.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:behaviors="clr-namespace:LabAssistant.Behaviors"
      Title="LogsPage">

    <StackPanel Margin="20">
        <TextBlock Text="Deployment Logs" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,20" />

        <!-- VM Inputs -->
        <ItemsControl ItemsSource="{Binding VmEntries}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Margin="0,10" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl>
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingName}" Value="True">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBox Text="{Binding VmName, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontWeight="Bold"
                                                                 FontSize="16"
                                                                 Width="200"
                                                                 VerticalAlignment="Center">
                                                                    <TextBox.InputBindings>
                                                                        <KeyBinding Key="Enter"
                                                                            Command="{Binding StopEditingCommand}" />
                                                                    </TextBox.InputBindings>
                                                                    <i:Interaction.Behaviors>
                                                                        <behaviors:LostFocusCommandBehavior Command="{Binding StopEditingCommand}" />
                                                                    </i:Interaction.Behaviors>
                                                                </TextBox>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding VmName}"
                                                                   FontWeight="Bold"
                                                                   FontSize="16"
                                                                   Width="200"
                                                                   VerticalAlignment="Center">
                                                                    <TextBlock.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding StartEditingCommand}" />
                                                                    </TextBlock.InputBindings>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </StackPanel>
                        </Expander.Header>

                        <StackPanel Margin="10">
                            <!-- VHD Path -->
                            <StackPanel Orientation="Vertical" Margin="0,5">
                                <TextBlock Text="VHD Path:" FontWeight="SemiBold"/>
                                <TextBox Width="300"
                                 Text="{Binding VhdPath, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Virtual Switch -->
                            <StackPanel Orientation="Vertical" Margin="0,5">
                                <TextBlock Text="Virtual Switch:" FontWeight="SemiBold"/>
                                <ComboBox Width="200"
                                  ItemsSource="{Binding DataContext.AvailableSwitches, RelativeSource={RelativeSource AncestorType=Page}}"
                                  SelectedItem="{Binding VirtualSwitchName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Per-VM Options -->
                            <CheckBox Content="Configure Time Zone"
                              IsChecked="{Binding ConfigureTimeZone, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,10,0,0"/>
                            <CheckBox Content="Install Software"
                              IsChecked="{Binding InstallSoftware, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,5,0,0"/>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Add VM" Command="{Binding AddVmCommand}" Margin="0,0,10,0" Width="100"/>
            <Button Content="Deploy" Command="{Binding DeployAllCommand}" Width="100"/>
            <ProgressBar Width="100" Height="20" IsIndeterminate="{Binding IsDeploying}" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Logs -->
        <ListView ItemsSource="{Binding Logs}" MaxHeight="300"/>
    </StackPanel>

</Page>
