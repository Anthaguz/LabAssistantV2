<Window x:Class="LabAssistant.Views.MissingVhdxResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve Missing VHDX" Height="420" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Some VMs reference VHDX entries not found in your catalog. Select replacements or import new VHDX files."
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyCatalogHint"
                       Text="Your catalog is empty. Click Import VHDX to add entries."
                       Foreground="#FFC00000"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="VM" Binding="{Binding VmName}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Missing VHDX Id" Binding="{Binding MissingId}" IsReadOnly="True" Width="2*"/>
                <DataGridTemplateColumn Header="Select VHDX" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.CatalogOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Import VHDX" Width="110" Margin="0,0,8,0" Click="ImportVhdx_Click"/>
            <Button x:Name="OkButton" Content="Resolve" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Resolve_Click"/>
            <Button Content="Cancel" Width="110" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
