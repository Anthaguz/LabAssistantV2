<Page x:Class="LabAssistant.Views.DryRunResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DryRunResultsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Dry-Run Results" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" Margin="0,4,0,0"/>
        </StackPanel>

        <ListView x:Name="StepsList" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="VM" DisplayMemberBinding="{Binding VmName}" Width="180"/>
                    <GridViewColumn Header="Step" DisplayMemberBinding="{Binding Name}" Width="220"/>
                    <GridViewColumn Header="Details" DisplayMemberBinding="{Binding Details}" Width="300"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
