<Page x:Class="LabAssistant.Views.VhdxCatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="VhdxCatalogPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="VHDX Catalog" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="CatalogPathText" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <ListView x:Name="CatalogListView" Grid.Row="1" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="120"/>
                    <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="260"/>
                    <GridViewColumn Header="OS Name" DisplayMemberBinding="{Binding OsName}" Width="140"/>
                    <GridViewColumn Header="OS Version" DisplayMemberBinding="{Binding OsVersion}" Width="120"/>
                    <GridViewColumn Header="Gen" DisplayMemberBinding="{Binding Generation}" Width="60"/>
                    <GridViewColumn Header="Notes" DisplayMemberBinding="{Binding Notes}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Width="90" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="Edit" Width="90" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button Content="Delete" Width="90" Margin="0,0,8,0" Click="Delete_Click"/>
            <Button Content="Reload" Width="90" Click="Reload_Click"/>
        </StackPanel>
    </Grid>
</Page>
