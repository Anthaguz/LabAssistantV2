<UserControl x:Class="LabAssistant.Views.Controls.VmConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Expander Header="General" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="VM Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="NameWarningText"
                               Foreground="#FFC00000"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Expander>

            <Expander Header="Resources" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Memory (MB)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="MemoryBox" Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="MemoryWarningText"
                               Foreground="#FFC00000"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>

                    <TextBlock Text="CPU Count" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBox x:Name="CpuBox" Text="{Binding CpuCount, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="CpuWarningText"
                               Foreground="#FFC00000"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Expander>

            <Expander Header="Network" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{Binding SwitchWarning}"
                               Foreground="#FFC00000"
                               Margin="0,0,0,8"
                               Visibility="{Binding ShowSwitchWarning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Virtual Switch" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SwitchBox"
                              ItemsSource="{Binding AvailableSwitches}"
                              SelectedItem="{Binding SwitchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding HasSwitches}"
                              IsEditable="False"/>
                    <TextBlock x:Name="SwitchWarningText"
                               Foreground="#FFC00000"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Expander>

            <Expander Header="OS" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Selected VHDX" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SelectedVhdxText"
                               Foreground="#FF666666"
                               Text="No VHDX selected"/>

                    <TextBlock x:Name="SelectedVhdxPathText"
                               Foreground="#FF666666"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="VhdxWarningText"
                               Foreground="#FFC00000"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SelectVhdxButton" Content="Select VHDX" Width="110" Margin="0,0,8,0" Click="SelectVhdx_Click"/>
                        <Button Content="Import VHDX" Width="100" Click="AddVhdx_Click"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="Roles" IsExpanded="False">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Role configurations will appear here."
                               Foreground="#FF666666"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
