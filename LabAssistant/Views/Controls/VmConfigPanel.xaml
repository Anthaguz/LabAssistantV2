<UserControl x:Class="LabAssistant.Views.Controls.VmConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Expander Header="General" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="VM Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="NameWarningText"
                               Foreground="#FFC00000"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Expander>

            <Expander Header="Resources" IsExpanded="True" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Memory (MB)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="MemoryBox" Text="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="MemoryWarningText"
                               Foreground="#FFC00000"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>

                    <TextBlock Text="CPU Count" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <TextBox x:Name="CpuBox" Text="{Binding CpuCount, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="CpuWarningText"
                               Foreground="#FFC00000"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Expander>

            <Expander Header="Network" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{Binding SwitchWarning}"
                               Foreground="#FFC00000"
                               Margin="0,0,0,8"
                               Visibility="{Binding ShowSwitchWarning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Virtual Switch" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SwitchBox"
                              ItemsSource="{Binding AvailableSwitches}"
                              SelectedItem="{Binding SwitchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding HasSwitches}"
                              IsEditable="False"/>
                    <TextBlock x:Name="SwitchWarningText"
                               Foreground="#FFC00000"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>

                    <Separator Margin="0,12,0,8"/>
                    <TextBlock Text="Guest OS Network Configuration" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Not implemented yet. These settings are shown for planning and will not run."
                               Foreground="#FF666666"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <CheckBox Content="Enable guest network configuration (coming soon)"
                              IsEnabled="False"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="IP Address" Foreground="#FF666666" Margin="0,0,0,4"/>
                    <TextBox IsEnabled="False" Text="" />
                    <TextBlock Text="Default Gateway" Foreground="#FF666666" Margin="0,8,0,4"/>
                    <TextBox IsEnabled="False" Text="" />
                    <TextBlock Text="DNS Servers (comma-separated)" Foreground="#FF666666" Margin="0,8,0,4"/>
                    <TextBox IsEnabled="False" Text="" />
                </StackPanel>
            </Expander>

            <Expander Header="OS" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Selected VHDX" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SelectedVhdxText"
                               Foreground="#FF666666"
                               Text="No VHDX selected"/>

                    <TextBlock x:Name="SelectedVhdxPathText"
                               Foreground="#FF666666"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="VhdxWarningText"
                               Foreground="#FFC00000"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="SelectVhdxButton" Content="Select VHDX" Width="110" Margin="0,0,8,0" Click="SelectVhdx_Click"/>
                        <Button Content="Import VHDX" Width="100" Click="AddVhdx_Click"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="Deployment Steps" IsExpanded="False" Margin="0,0,0,10">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Mandatory" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="MandatoryStepsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#FF666666" Margin="0,0,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Optional" FontWeight="SemiBold" Margin="0,10,0,6"/>
                    <StackPanel Margin="0,0,0,8">
                        <CheckBox x:Name="ConfigureTimeZoneCheckBox"
                                  Content="Set Time Zone"
                                  IsChecked="{Binding ConfigureTimeZoneEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,4"/>
                        <CheckBox x:Name="InstallSoftwareCheckBox"
                                  Content="Install Software"
                                  IsChecked="{Binding InstallSoftwareEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,4"/>
                        <CheckBox x:Name="InstallRoleCheckBox"
                                  Content="Install Role"
                                  IsChecked="{Binding InstallRoleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,4"/>
                    </StackPanel>

                    <TextBlock Text="Placeholders (not implemented)" FontWeight="SemiBold" Margin="0,4,0,6"/>
                    <CheckBox Content="Configure Guest Network Information (coming soon)"
                              IsEnabled="False"
                              ToolTip="Not implemented yet"/>
                    <TextBlock Text="Visible for planning only. This step will be skipped until implemented."
                               Foreground="#FF666666"
                               Margin="24,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
