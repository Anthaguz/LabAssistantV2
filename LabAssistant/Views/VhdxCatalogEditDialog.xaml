<Window x:Class="LabAssistant.Views.VhdxCatalogEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VHDX Catalog Item"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Path" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0" MinHeight="26" Padding="6,3" VerticalContentAlignment="Center"/>
            <Button Content="Browse..." Grid.Column="1" Margin="8,0,0,0" Click="Browse_Click"/>
        </Grid>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="OS Name" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="OsNameBox" Grid.Row="1" Grid.Column="1" MinHeight="26" Padding="6,3" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="OS Version" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="OsVersionBox" Grid.Row="2" Grid.Column="1" MinHeight="26" Padding="6,3" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Generation" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox x:Name="GenerationBox" Grid.Row="3" Grid.Column="1" MinHeight="26" Padding="6,3" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes" VerticalAlignment="Top" Margin="0,2,8,8"/>
        <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
            <TextBox x:Name="NotesBox" Height="60" Padding="6,4" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="NotesBox_TextChanged"/>
            <TextBlock x:Name="NotesHint"
                       Text="Example: patched to 2025-01, includes latest CU"
                       Margin="8,6,0,0"
                       Foreground="Gray"
                       IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
