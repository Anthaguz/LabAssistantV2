<Page x:Class="LabAssistant.Views.DeployPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DeployPage"
      Background="{StaticResource SystemPageBackgroundBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Lab Deployment Overview"
                   FontSize="24"
                   Foreground="{StaticResource SystemBaseHighColor}"
                   Margin="0,0,0,20"/>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Style="{StaticResource FluentButtonStyle}" Content="Add VM" Command="{Binding AddVmCommand}" IsEnabled="{Binding IsConfigurationEditingEnabled}" Margin="0,0,10,0" Width="100"/>
            <Button Style="{StaticResource FluentButtonStyle}" Content="Save as Template" Command="{Binding SaveAsTemplateCommand}" IsEnabled="{Binding IsConfigurationEditingEnabled}" Margin="0,0,10,0" Width="150"/>
            <Button Style="{StaticResource FluentButtonStyle}" Content="Deploy" Command="{Binding DeployAllCommand}" IsEnabled="{Binding CanStartDeploymentOperation}" Width="100"/>
            <Button Style="{StaticResource FluentButtonStyle}"
                    Content="Cancel"
                    Command="{Binding CancelDeploymentCommand}"
                    IsEnabled="{Binding CanCancelDeploymentOperation}"
                    Visibility="{Binding ShowCancelDeploymentAction, Converter={StaticResource BoolToVisibilityConverter}}"
                    Width="100"
                    Margin="10,0,0,0"/>
            <ProgressBar Width="100" Height="20" IsIndeterminate="{Binding IsDeploying}" Margin="10,0,0,0"/>
            <TextBlock Text="{Binding OperationState}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource SystemBaseHighColor}"/>
        </StackPanel>

        <Border Grid.Row="2" Grid.ColumnSpan="2"
                BorderBrush="#FFDDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Deployment Readiness"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="{Binding IsReadinessCheckInProgress, StringFormat=Checking: {0}}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding ReadinessReport.Mode, StringFormat=Mode: {0}}"/>
                    </StackPanel>
                </DockPanel>

                <WrapPanel Margin="0,8,0,6">
                    <TextBlock Text="{Binding ReadinessPassCount, StringFormat=Pass: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding ReadinessWarnCount, StringFormat=Warn: {0}}" Margin="0,0,16,0" Foreground="#FF8A5A00"/>
                    <TextBlock Text="{Binding ReadinessFailCount, StringFormat=Fail: {0}}" Margin="0,0,16,0" Foreground="#FFB00020"/>
                    <TextBlock Text="{Binding IsDeployBlockedByReadiness, StringFormat=Deploy Blocked: {0}}" Foreground="#FFB00020"/>
                </WrapPanel>

                <TextBlock Text="{Binding ReadinessStatusMessage}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Foreground="{StaticResource SystemBaseHighColor}"/>

                <ItemsControl ItemsSource="{Binding ReadinessReport.Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFE5E5E5" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                        <Run Text="{Binding Status}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Category}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Code}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ActionableGuidance}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#FF0A5A9C"/>
                                    <TextBlock Text="{Binding ResourcePath, StringFormat=Path: {0}}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ResourceName, StringFormat=Resource: {0}}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding AffectedVmNames}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=VM: {0}}" Margin="0,2,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="2"
                BorderBrush="#FFDDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDeploymentSummary}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Deployment Outcome Summary" FontSize="16" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,8,0,8">
                    <TextBlock Text="{Binding DeploymentSummary.OperationState, StringFormat=State: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding DeploymentSummary.TotalVmCount, StringFormat=Total: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding DeploymentSummary.SucceededVmCount, StringFormat=Succeeded: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding DeploymentSummary.FailedVmCount, StringFormat=Failed: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding DeploymentSummary.CancelledVmCount, StringFormat=Cancelled: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding DeploymentSummary.CleanupVmCount, StringFormat=Cleanup: {0}}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding DeploymentSummary.ResidualVmCount, StringFormat=Residual VMs: {0}}"/>
                </WrapPanel>

                <ItemsControl ItemsSource="{Binding DeploymentSummary.VmOutcomes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFE5E5E5" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock FontWeight="SemiBold" DockPanel.Dock="Left">
                                            <Run Text="{Binding VmName}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Status}"/>
                                        </TextBlock>
                                        <Button Content="Open VM"
                                                DockPanel.Dock="Right"
                                                Command="{Binding DataContext.OpenVmOutcomeDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Cleanup.Status, StringFormat=Cleanup: {0}}"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Cleanup.ResidualCount, StringFormat=Residuals: {0}}"/>
                                    <TextBlock Text="{Binding Reason, StringFormat=Reason: {0}}"
                                               TextWrapping="Wrap"
                                               Foreground="#FFB00020"/>
                                    <ItemsControl ItemsSource="{Binding Residuals}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,2,0,0" Foreground="#FFB00020" TextWrapping="Wrap">
                                                    <Run Text="Residual: "/>
                                                    <Run Text="{Binding ResourceType}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding Identifier}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="{Binding DeploymentSummary.Residuals.Count, StringFormat=Aggregated Residuals ({0})}"
                          IsExpanded="False"
                          Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding DeploymentSummary.Residuals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run Text="{Binding VmName}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding ResourceType}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Identifier}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </Border>

        <!-- VM Cards + Logs -->
        <Grid Grid.Row="4" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- VM Cards -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,10,0"
                          IsEnabled="{Binding IsConfigurationEditingEnabled}">
                <ItemsControl ItemsSource="{Binding VmEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource VmCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Main clickable area for opening VM detail -->
                                    <Button Command="{Binding DataContext.OpenVmDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="16"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        Cursor="Hand"
                                        Grid.ColumnSpan="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding VmName}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SystemBaseHighColor}"
                                               VerticalAlignment="Center"/>

                                            <!-- Trash icon button -->
                                            <Button Style="{StaticResource TrashIconButtonStyle}"
                                                    Command="{Binding DataContext.DeleteVmCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Remove VM"
                                                Grid.Column="1"
                                                Padding="0"
                                                Margin="12,0,0,0">
                                                <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Foreground="{StaticResource SystemBaseLowColor}"
                                                   VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Arrow icon -->
                                            <TextBlock Text="&#xE76C;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="16"
                                               Foreground="{StaticResource SystemBaseLowColor}"
                                               VerticalAlignment="Center"
                                               Grid.Column="2"
                                               Margin="12,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Logs Panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                <ItemsControl ItemsSource="{Binding LogGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding VmName}" IsExpanded="True" Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Margin="10,0,0,2"
                                                       Foreground="{StaticResource SystemBaseHighColor}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
