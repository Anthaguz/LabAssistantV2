<Page x:Class="LabAssistant.Views.TemplateEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TemplateEditorPage">

    <Page.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="Template Editor"
                           FontSize="24"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Open" Width="70" Margin="0,0,8,0" Click="OpenTemplate_Click"/>
                    <Button Content="Save" Width="70" Margin="0,0,8,0" Click="SaveTemplate_Click"/>
                    <Button Content="Save As" Width="80" Click="SaveTemplateAs_Click"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding CurrentTemplatePath}"
                       Foreground="#FF666666"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#FFDDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,12">
                    <TextBlock Text="Template Id" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Template.Id, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Version" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Template.Version, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,12,0">
                    <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Template.Name, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1">
                    <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Template.Description, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="ValidationPanel"
                    Grid.Row="0"
                    BorderBrush="#FFFFB6B6"
                    Background="#FFFFEFEF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Fix the following issues before saving:"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"/>
                        <Button x:Name="ValidationToggleButton"
                                Content="Collapse"
                                Width="90"
                                DockPanel.Dock="Right"
                                Click="ValidationToggle_Click"/>
                    </DockPanel>

                    <StackPanel x:Name="ValidationContentPanel">
                        <TextBlock Text="Filter by VM name" Foreground="#FF666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="ValidationFilterBox"
                                 MinHeight="28"
                                 Margin="0,0,0,8"
                                 Padding="6,3"
                                 VerticalContentAlignment="Center"
                                 TextChanged="ValidationFilter_TextChanged"/>
                        <ItemsControl x:Name="ValidationItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="ValidationItem_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4"
                                            HorizontalContentAlignment="Left"
                                            Tag="{Binding}">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   Foreground="#FFB00020"
                                                   TextWrapping="Wrap"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="VmListPanel"
                    Grid.Row="1"
                    BorderBrush="#FFDDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Virtual Machines"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"/>
                        <Button Content="Add VM" Width="90" Click="AddVm_Click" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VmTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFCCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Click="OpenVmDetail_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="12"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Grid.ColumnSpan="3"
                                                    Tag="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding MemoryMb, StringFormat=Memory (MB): {0}}"
                                                               Foreground="#FF666666"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding CpuCount, StringFormat=CPU: {0}}"
                                                               Foreground="#FF666666"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Click="RemoveVm_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Tag="{Binding}">
                                                <TextBlock Text="&#xE74D;"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="16"
                                                           Foreground="#FF666666"
                                                           VerticalAlignment="Center"/>
                                            </Button>

                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="16"
                                                       Foreground="#FF666666"
                                                       VerticalAlignment="Center"
                                                       Grid.Column="2"
                                                       Margin="0,0,12,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Frame x:Name="VmDetailFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
