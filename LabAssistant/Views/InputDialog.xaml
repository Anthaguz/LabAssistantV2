<Window x:Class="LabAssistant.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="150" Width="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="10">
        <TextBlock x:Name="MessageText" Margin="0,0,0,10"/>
        <TextBox x:Name="ResponseBox" Margin="0,0,0,10"/>
        <Button Content="OK" HorizontalAlignment="Right" Width="75" Click="OkButton_Click"/>
    </StackPanel>
</Window>
