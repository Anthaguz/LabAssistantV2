<Page x:Class="LabAssistant.Views.TemplateVmDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:LabAssistant.Views.Controls"
      Title="TemplateVmDetailPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
            <Button Click="BackButton_Click"
                    Content="&lt;-"
                    Width="32"
                    Height="32"
                    Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="{Binding Name}"
                           FontSize="22"
                           FontWeight="Bold"/>
                <TextBlock Text="VM Settings"
                           Foreground="#FF666666"/>
            </StackPanel>
        </StackPanel>

        <controls:VmConfigPanel x:Name="VmConfigPanel" Grid.Row="1"/>
    </Grid>
</Page>
