<Window x:Class="LabAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Resources/LabAssistant.ico"
        Title="Lab Assistant" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Sidebar width -->
            <ColumnDefinition Width="*"/>
            <!-- Main content -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Background="#FF2D2D30" Orientation="Vertical">
            <Button Content="Deploy VMs" Name="DeployButton" Margin="10" Click="DeployButton_Click"/>
            <Button Content="Templates" Name="TemplatesButton" Margin="10" Click="TemplatesButton_Click"/>
            <Button Content="Switches" Name="SwitchesButton" Margin="10" Click="SwitchesButton_Click"/>
            <Button Content="Settings" Name="SettingsButton" Margin="10" Click="SettingsButton_Click"/>
            <Button Content="Logs" Name="LogsButton" Margin="10" Click="LogsButton_Click"/>
        </StackPanel>

        <!-- Main Content Frame -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="ErrorBanner"
                    Grid.Row="0"
                    Background="#FFFFE1"
                    BorderBrush="#FFCC00"
                    BorderThickness="1"
                    Padding="8"
                    Margin="10"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorBannerText" Foreground="Black"/>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
