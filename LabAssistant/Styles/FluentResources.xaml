<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:LabAssistant.Converters">

    <!-- Converters -->
    <converters:HeightOffsetConverter x:Key="HeightOffsetConverter" Offset="100"/>

    <!-- Base Text -->
    <SolidColorBrush x:Key="SystemBaseHighColor" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="SystemBaseMidColor" Color="#FFB0B0B0"/>
    <SolidColorBrush x:Key="SystemBaseLowColor" Color="#FF606060"/>

    <!-- Accent Palette -->
    <SolidColorBrush x:Key="SystemAccentColor" Color="#FF3786F2"/>
    <SolidColorBrush x:Key="SystemAccentLightColor" Color="#FF5091D2"/>
    <SolidColorBrush x:Key="SystemAccentMutedColor" Color="#FF2458A4"/>

    <!-- Feedback -->
    <SolidColorBrush x:Key="SystemSuccessColor" Color="#FF43A047"/>
    <SolidColorBrush x:Key="SystemWarningColor" Color="#FFFBC02D"/>
    <SolidColorBrush x:Key="SystemErrorColor" Color="#FFE53935"/>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="SystemPageBackgroundBrush" Color="#FF121212"/>
    <SolidColorBrush x:Key="SystemPanelBackgroundColor" Color="#FF3F3B3B"/>
    <SolidColorBrush x:Key="SystemControlBackgroundBrush" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="SystemControlHoverBrush" Color="#FF353535"/>

    <!-- Layout -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

    <!-- Card Style -->
    <Style x:Key="VmCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,14,0,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{StaticResource SystemPanelBackgroundColor}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black"
                                  Direction="270"
                                  ShadowDepth="2"
                                  BlurRadius="6"
                                  Opacity="0.3"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SystemControlHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TrashIconButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SystemBaseLowColor}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SystemErrorColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Expander Style -->
    <Style TargetType="Expander">
        <Setter Property="Background" Value="{StaticResource SystemControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SystemBaseHighColor}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SystemControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SystemBaseHighColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ComboBox Style -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SystemControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SystemBaseHighColor}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <DockPanel>
                                <TextBlock Text="{TemplateBinding SelectionBoxItem}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Margin="6,2,0,2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>

                                <ToggleButton DockPanel.Dock="Right"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False"
                                  ClickMode="Press"
                                  Width="24"
                                  Margin="4,2,4,2"
                                  Cursor="Hand"
                                  Background="{StaticResource SystemAccentColor}"
                                  Foreground="{StaticResource SystemBaseHighColor}"
                                  BorderBrush="{StaticResource SystemAccentMutedColor}"
                                  BorderThickness="1"
                                  Padding="0"
                                  Content="▾">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="{StaticResource SystemAccentColor}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource SystemAccentMutedColor}"/>
                                            <Setter Property="Foreground" Value="{StaticResource SystemBaseHighColor}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SystemAccentLightColor}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SystemAccentMutedColor}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </DockPanel>
                        </Border>

                        <Popup Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">              
                            <Border Background="{StaticResource SystemControlBackgroundBrush}"
                                BorderBrush="{StaticResource SystemAccentColor}"
                                BorderThickness="1"
                                MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer Margin="4" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem Style -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource SystemControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SystemBaseHighColor}"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SystemControlHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SystemAccentMutedColor}"/>
                <Setter Property="Foreground" Value="{StaticResource SystemBaseHighColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CheckBox Style -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SystemBaseHighColor}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- Fluent Button Style -->
    <Style x:Key="FluentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SystemAccentColor}"/>
        <Setter Property="Foreground" Value="{StaticResource SystemBaseHighColor}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="FluentButtonBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FluentButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource SystemAccentLightColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="FluentButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource SystemAccentMutedColor}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>