<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.3.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabAssistant.Models\LabAssistant.Models.csproj" />
    <ProjectReference Include="..\LabAssistant.Diagnostics.CodeGen\LabAssistant.Diagnostics.CodeGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The status-code registry, consumed by the source generator to emit LaStatus + StatusCodeCatalog. -->
    <AdditionalFiles Include="Diagnostics\status-codes.yaml" />
  </ItemGroup>

</Project>
